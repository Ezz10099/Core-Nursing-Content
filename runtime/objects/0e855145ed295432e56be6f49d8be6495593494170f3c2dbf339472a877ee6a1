iogenic Shock & Poor Perfusion","stage":"comprehensive","reviewStatus":"authoring draft","passRule":{"type":"error-count","allowedErrors":1},"timing":{"timed":false,"secondsPerQuestion":null,"timerEnforcement":"untimed"},"scoring":{"correct":1,"incorrect":0,"unanswered":0,"partialCredit":false,"unsureOrGuessed":"review flag only","criticalSafetyMiss":"separate follow-up required; original numeric score unchanged"},"feedback":"incorrect, unanswered and unsure/guessed questions only after submission","retestPolicy":"same comprehensive exam and questions at every stage","questions":[{"stem":"Which mechanism defines cardiogenic shock?","choices":[{"id":"A","text":"An empty intravascular tank as the primary mechanism","explanation":"That describes hypovolemic shock."},{"id":"B","text":"Pathological vasodilation as the primary mechanism","explanation":"That describes a distributive pattern."},{"id":"C","text":"Insufficient cardiac pumping to perfuse organs","explanation":"The primary problem is a weak pump and inadequate effective output."},{"id":"D","text":"Mechanical obstruction to flow as the primary mechanism","explanation":"That describes an obstructive pattern."}],"format":"single-best-answer","point":"Cardiogenic shock is pump failure with organ hypoperfusion.","criticalForSafety":false,"id":"ccu-lesson-08-cardiogenic-shock--comprehensive--point-5fd178011d01","points":1,"learningPointIds":["ccu-lesson-08-cardiogenic-shock::point-5fd178011d01"],"answerKey":"C"},{"stem":"Which cluster supports concern about inadequate organ perfusion?","choices":[{"id":"A","text":"A normal pain score with no other findings","explanation":"Pain severity does not establish adequate organ perfusion."},{"id":"B","text":"Cold skin, weak pulses, confusion, and low urine output","explanation":"These are indicators of hypoperfusion."},{"id":"C","text":"Warm comfortable skin with stable mentation alone","explanation":"This does not establish the low-output cluster."},{"id":"D","text":"Normal 