297f9ef846ac"],"reusedFromQuestionId":"ibd2-lesson-02-external-fixator--advanced--point-297f9ef846ac","answerKey":"C"},{"stem":"A pin site becomes hot, swollen, and draining. What additional assessment best supports the report?","choices":[{"id":"A","text":"Vitals, pain trend, wound findings, and distal neurovascular status","explanation":"These establish local and systemic impact."},{"id":"B","text":"The hardware serial number without clinical findings","explanation":"A device identifier does not replace assessment."},{"id":"C","text":"The dressing brand without a patient assessment","explanation":"Branding does not describe infection severity or limb function."},{"id":"D","text":"The next elective clinic date without current observations","explanation":"Current deterioration needs current findings."}],"format":"single-best-answer","point":"Assess the whole patient and wound, report deterioration, document, and reassess.","criticalForSafety":false,"id":"ibd2-lesson-02-external-fixator--7-day--point-08afffcbe885","points":1,"learningPointIds":["ibd2-lesson-02-external-fixator::point-08afffcbe885"],"reusedFromQuestionId":"ibd2-lesson-02-external-fixator--advanced--point-08afffcbe885","answerKey":"A"}],"questionCount":9}],"scoringExclusions":[]},{"itemId":"ibd2-quick-taylor-spatial-frame","title":"Taylor Spatial Frame (TSF) — Bedside Nursing","itemType":"lesson","exams":[{"id":"ibd2-quick-taylor-spatial-frame--comprehensive","itemId":"ibd2-quick-taylor-spatial-frame","itemType":"lesson","title":"Taylor Spatial Frame (TSF) — Bedside Nursing","stage":"comprehensive","reviewStatus":"authoring draft","passRule":{"type":"error-count","allowedErrors":2},"timing":{"timed":false,"secondsPerQuestion":null,"timerEnforcement":"untimed"},"scoring":{"correct":1,"incorrect":0,"unanswered":0,"partialCredit":false,"unsureOrGuessed":"review flag only","criticalSafetyMiss":"separate follow-up required; original numeric score unchanged"},"feedback":"incorrect, unanswered and unsure/guessed questions only after submission","retestPolicy":"same comprehensive exam and questions at every stage","questions":[{"stem":"What does Taylor Spatial Frame describe?","choices":[{"id":"A","text":"A skeletal traction system with suspended weights","explanation":"Traction weights are not the TSF system."},{"id":"B","text":"A linear external fixator with a single connecting bar","explanation":"This lacks the characteristic circular hexapod arrangement."},{"id":"C","text":"A circular external fixator with adjustable struts","explanation":"This describes the TSF system."},{"id":"D","text":"An internal fixation plate with locking screws","explanation":"An internal plate is not an external hexapod frame."}],"format":"single-best-answer","point":"TSF is a hexapod circular external fixator for stabilization and correction.","criticalForSafety":false,"id":"ibd2-quick-taylor-spatial-frame--comprehensive--point-b006317b7879","points":1,"learningPointIds":["ibd2-quick-taylor-spatial-frame::point-b006317b7879"],"answerKey":"C"},{"point":"The principal hexapod arrangement has six adjustable struts.","format":"numeric-entry","stem":"How many adjustable telescopic struts connect the principal rings in the basic TSF arrangement?","answer":6,"unit":"struts","tolerance":0,"explanation":"The hexapod arrangement uses six main struts; complex frames may add components.","criticalForSafety":false,"id":"ibd2-quick-taylor-spatial-frame--comprehensive--point-cbb3ccedabc0","points":1,"learningPointIds":["ibd2-quick-taylor-spatial-frame::point-cbb3ccedabc0"]},{"stem":"Which TSF components pass through skin into bone to connect the limb to the frame?","choices":[{"id":"A","text":"Telescopic strut bodies","explanation":"Struts connect the external rings rather than serving as the skin-crossing bone anchors."},{"id":"B","text":"The ring circumference alone","explanation":"Rings surround the limb; pins/wires provide attachment."},{"id":"C","text":"The software-generated paper schedule","explanation":"Instructions are not a physical bone attachment."},{"id":"D","text":"Wires and/or half-pins","explanation":"They provide the bone-to-frame attachment."}],"format":"single-best-answer","point":"Pins/wires connect bone to the external rings.","criticalForSafety":false,"id":"ibd2-quick-taylor-spatial-frame--comprehensive--point-e57f651c3d2f","points":1,"learningPointIds":["ibd2-quick-taylor-spatial-frame::point-e57f651c3d2f"],"answerKey":"D"},{"stem":"What is a purpose of a Taylor Spatial Frame?","choices":[{"id":"A","text":"Measurement of compartment pressure during routine walking","explanation":"A TSF is not a compartment-pressure measuring device."},{"id":"B","text":"Gradual deformity correction or limb lengthening","explanation":"These are taught purposes of the frame."},{"id":"C","text":"Direct removal of infected bone without an operation","explanation":"The frame does not itself perform debridement."},{"id":"D","text":"Permanent replacement of an artificial knee joint","explanation":"A TSF is not a joint prosthesis."}],"format":"single-best-answer","point":"TSF may be used for complex fractures, deformity, lengthening, or reconstruction.","criticalForSafety":false,"id":"ibd2-quick-taylor-spatial-frame--comprehensive--point-651505cdaed0","points":1,"learningPointIds":["ibd2-quick-taylor-spatial-frame::point-651505cdaed0"],"answerKey":"B"},{"stem":"What determines planned TSF strut-length changes?","choices":[{"id":"A","text":"An individualized written correction schedule based on the surgeon’s plan","explanation":"Measurements, imaging, and software support the authorized schedule."},{"id":"B","text":"The intern’s preferred direction of visible alignment","explanation":"Visual preference does not authorize a correction."},{"id":"C","text":"The patient’s pain score as a direct turn-count formula","explanation":"Pain is not an independent adjustment prescription."},{"id":"D","text":"A universal daily turn count used for every TSF","explanation":"The plan is individualized rather than universal."}],"format":"single-best-answer","point":"Correction follows a surgeon-planned individualized schedule.","criticalForSafety":false,"id":"ibd2-quick-taylor-spatial-frame--comprehensive--point-d1501cbdc26f","points":1,"learningPointIds":["ibd2-quick-taylor-spatial-frame::point-d1501cbdc26f"],"answerKey":"A"},{"stem":"Which set best checks limb safety before inspecting the rest of a TSF?","choices":[{"id":"A","text":"The next scheduled X-ray date without current findings","explanation":"A future study does not replace bedside assessment."},{"id":"B","text":"Ring count and paint condition without a limb examination","explanation":"Device appearance alone cannot establish tissue safety."},{"id":"C","text":"Strut length without a distal examination","explanation":"A length reading does not assess nerve or blood supply."},{"id":"D","text":"Pain trend, perfusion, sensation, movement, swelling, and pressure points","explanation":"These assess tissue and nerve function distal to the injury."}],"format":"single-best-answer","point":"Distal neurovascular assessment precedes frame-focused reassurance.","criticalForSafety":false,"id":"ibd2-quick-taylor-spatial-frame--comprehensive--point-0cfa2609d327","points":1,"learningPointIds":["ibd2-quick-taylor-spatial-frame::point-0cfa2609d327"],"answerKey":"D"},{"stem":"Which TSF change needs prompt reporting?","choices":[{"id":"A","text":"New purulent drainage or unusual frame movement","explanation":"Infection and hardware changes are both explicit red flags."},{"id":"B","text":"A stable written schedule without new symptoms","explanation":"This does not establish deterioration."},{"id":"C","text":"An unchanged pin site with improving comfort","explanation":"This is not the warning pattern."},{"id":"D","text":"A stable alignment without skin pressure or symptoms","explanation":"No new problem is described."}],"format":"single-best-answer","point":"Recognize pin infection, hardware failure, skin pressure, and alignment red flags.","criticalForSafety":false,"id":"ibd2-quick-taylor-spatial-frame--comprehensive--point-1445ea942bfc","points":1,"learningPointIds":["ibd2-quick-taylor-spatial-frame::point-1445ea942bfc"],"answerKey":"A"},{"stem":"Which note best supports reassessment after a TSF concern?","choices":[{"id":"A","text":"“Frame checked; fine” without findings or timing","explanation":"This does not document the actual assessment or response."},{"id":"B","text":"Timed findings, change from baseline, person notified, instructions, and response","explanation":"These describe the event and follow-up objectively."},{"id":"C","text":"“Doctor aware” without the change or received plan","explanation":"The note lacks the information needed for follow-up."},{"id":"D","text":"“Pain expected” without the trend or limb examination","explanation":"This can obscure a clinically important change."}],"format":"single-best-answer","point":"Document time, change, baseline comparison, notification, instructions, and response.","criticalForSafety":false,"id":"ibd2-quick-taylor-spatial-frame--comprehensive--point-4bb6b362ceb3","points":1,"learningPointIds":["ibd2-quick-taylor-spatial-frame::point-4bb6b362ceb3"],"answerKey":"B"},{"stem":"A trained patient adjusts their own TSF under a written schedule. An intern is asked to change the schedule because the limb looks different. Which distinction matters?","choices":[{"id":"A","text":"A patient request automatically substitutes for a surgical order","explanation":"A request does not authorize a plan change."},{"id":"B","text":"All TSF adjustments are prohibited even under a patient’s own plan","explanation":"A patient may perform this self-care after individual training and authorization."},{"id":"C","text":"Authorized individual self-care versus a new unsupervised adjustment decision","explanation":"Patient training does not authorize an intern to alter the surgical plan."},{"id":"D","text":"A visible alignment difference provides a numerical correction by itself","explanation":"It does not replace the planned assessment and schedule."}],"format":"single-best-answer","point":"Trained patient self-adjustment does not authorize an intern to improvise.","criticalForSafety":true,"id":"ibd2-quick-taylor-spatial-frame--comprehensive--point-d1b91e4aefdd","points":1,"learningPointIds":["ibd2-quick-taylor-spatial-frame::point-d1b91e4aefdd"],"answerKey":"C"},{"stem":"A TSF patient has rapidly worsening pain, passive-stretch pain, and new paresthesia while pulses remain present. Which complication is the urgent concern?","choices":[{"id":"A","text":"Expected adjustment discomfort established by the pulse","explanation":"The warning cluster needs emergency assessment."},{"id":"B","text":"An isolated cosmetic frame concern","explanation":"New pain and sensory change are tissue-safety findings."},{"id":"C","text":"A normal recovery established by intact hardware","explanation":"Hardware appearance does not establish neurovascular safety."},{"id":"D","text":"Acute compartment syndrome","explanation":"Pulse presence does not exclude threatened compartment perfusion."}],"format":"single-best-answer","point":"Pulses can persist during early compartment syndrome.","criticalForSafety":true,"id":"ibd2-quick-taylor-spatial-frame--comprehensive--point-71d0565ec147","points":1,"learningPointIds":["ibd2-quick-taylor-spatial-frame::point-71d0565ec147"],"answerKey":"D"},{"stem":"A TSF patient wants to increase weight bearing, but the current order is unclear. Which information should determine the activity plan?","choices":[{"id":"A","text":"The number of struts as a universal loading rule","explanation":"Strut count does not determine the individual order."},{"id":"B","text":"The verified patient-specific weight-bearing order","explanation":"Device presence alone does not establish permitted loading."},{"id":"C","text":"The patient’s ability to tolerate one unsupported step","explanation":"Tolerance does not replac