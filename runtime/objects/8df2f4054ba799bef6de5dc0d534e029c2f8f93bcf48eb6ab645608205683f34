/* Only the short, explicitly selected memory cues carry strong clinical colors. */
.memory-cues{display:grid;gap:10px;margin:16px 0}
.memory-cue{border:2px solid;border-radius:16px;padding:12px 14px}
.memory-cue strong{font-size:12px;letter-spacing:.035em;font-weight:850;display:block;margin-bottom:5px}
.memory-cue p{font-size:14px;font-weight:650;line-height:1.42;margin:0;white-space:normal}
.memory-cue.use{background:#103c2a;border-color:#26d07d;color:#d8ffe9}
.memory-cue.danger-cue{background:#441a23;border-color:#ff6177;color:#ffe3e7}
.med-section{padding:0;background:#191e27;border:1px solid #37414e;border-radius:15px;margin:9px 0;overflow:hidden}
.med-section summary{display:flex;align-items:center;gap:10px;justify-content:space-between;list-style:none;padding:14px 15px;font-size:15px;font-weight:760;cursor:pointer;color:#f2f5fb}
.med-section summary::-webkit-details-marker{display:none}
.med-section summary:after{content:"⌄";font-size:20px;line-height:1;color:#b9c5d9;float:none;margin-left:auto}
.med-section[open] summary:after{content:"⌃"}
.med-section .section-body{border-top:1px solid #303a48;padding:14px 15px;color:#dae2ed;font-size:14px;line-height:1.62}
.med-section .section-body p{white-space:pre-wrap;margin:0}
.med-section .section-body .med-bullets{margin:4px 0 0;padding-left:20px}
.med-section .section-body .med-bullets li{margin:7px 0}
.med-tools{display:flex;gap:8px;flex-wrap:wrap;margin:13px 0}
.med-tools button{font-size:12px;padding:8px 10px}
.about-source{margin:26px 0 0;background:#171d25;border:1px solid #303947;border-radius:13px;padding:13px 14px}
.about-source summary{cursor:pointer;color:#c3cfdf;font-size:13px;font-weight:700}
.about-source p{font-size:12px;line-height:1.55;color:#9fb0c5;margin:10px 0 0}


.contact-bar{display:flex;justify-content:flex-end;padding-bottom:8px}.contact-button{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;background:#18385f;border-color:#4279ba;color:#eef6ff;font-weight:700}.contact-button:focus-visible{outline:2px solid #90c4ff;outline-offset:3px}


.reading-badge{display:block;font-size:.82rem;margin:6px 0;color:var(--muted)}
.reading-control{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin:12px 0}
.reading-control button,.reading-filters button{font-size:.85rem;padding:9px 12px;min-height:40px}
.reading-filters{display:flex;gap:6px;flex-wrap:wrap;margin:8px 0 16px}
.reading-filters button[aria-pressed="true"]{background:#19675d;color:white;border-color:#19675d}
.reading-count{font-size:.9rem;margin:12px 0 6px}
.continue-item{display:block;width:100%;text-align:left;margin:8px 0;white-space:normal}
.continue-item span{display:block;font-size:.75rem;opacity:.75;margin-bottom:4px}
