ge-heading{margin:8px 0 7px;font-size:27px}.panel h3{font-size:14px;margin-bottom:7px}.panel p{margin:0;white-space:pre-wrap}.blue{background:#162844;border-color:#2d4f7d}.danger{background:#341b25;border-color:#723948}.danger h3{color:#ff9eae}.green{background:#162e29;border-color:#316650}.kicker{margin-bottom:6px}details summary{font-weight:750;cursor:pointer;list-style:none}details summary::after{content:'⌄';float:right}details[open] summary::after{content:'⌃'}details p{margin-top:11px!important}.options{display:grid;gap:9px;margin:14px 0}.options button{text-align:left;white-space:normal}.options button:disabled{opacity:.82;cursor:default}.correct{border-color:#278d5b!important;background:#163c2c!important;color:#b3f9d0!important}.incorrect{border-color:#bc4c66!important;background:#471d2b!important;color:#ffc1ce!important}.tools{display:flex;gap:8px;flex-wrap:wrap}.tools button{flex:1}.title-row{display:flex;align-items:center;gap:12px;margin:4px 0 16px}.title-row svg{color:#70a5ff}.title-row h1{font-size:25px;margin:0}footer{color:#8393a8;font-size:11px;line-height:1.6;margin:20px 0 0}.bottom-nav{position:fixed;bottom:0;left:0;right:0;z-index:20;background:#11161fef;backdrop-filter:blur(15px);border-top:1px solid #333b4a;padding:7px max(10px,env(safe-area-inset-right)) calc(7px + env(safe-area-inset-bottom)) max(10px,env(safe-area-inset-left))}.nav-inner{width:min(100%,680px);margin:auto;display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:4px}.bottom-nav button{display:flex;flex-direction:column;align-items:center;gap:4px;padding:5px 2px 3px;border:0;border-radius:12px;background:transparent;color:#9aa9c1;font-size:10px;font-weight:650;min-width:0}.bottom-nav button svg{height:21px;width:21px}.bottom-nav button[aria-pressed=true]{background:#1c3355;color:#88b8ff}.catalog-tabs{display:flex;gap:6px;overflow-x:auto;margin:15px 0 9px;padding-bottom:3px}.catalog-tabs button{font-size:12px;white-space:nowrap;border-radius:100px;padding:8px 11px}.catalog-t