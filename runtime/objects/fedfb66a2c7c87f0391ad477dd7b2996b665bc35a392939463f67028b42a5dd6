1-fe79f64d12d303bd"},{"field":"use","label":"Main use","text":"Bronchodilation in bronchospasm, especially COPD and some asthma exacerbations.","id":"section-2-4914e9f9e7a5f138"},{"field":"administration","label":"Form & administration","text":"Nebulized/inhaled solution; not IV. Give the exact ordered dose using the nebulizer/device. It may be combined with salbutamol when ordered. Do not assume one dilution volume across products.","id":"section-3-69b312fca1321137"},{"field":"monitor","label":"Nursing considerations","text":"• Reassess work of breathing, wheeze, RR and SpO2. • Dry mouth/throat irritation can occur. • Avoid directing nebulized mist into the eyes. • Use caution in patients prone to urinary retention. • Worsening respiratory distress requires reassessment/escalation, not reliance on the nebulizer alone.","id":"section-4-2f4278f458024c5d"},{"field":"why","label":"Essential rationale","text":"Ipratropium blocks muscarinic vagal bronchoconstriction, relaxing airway smooth muscle.","id":"section-5-826b1889845d391d"},{"field":"availability","label":"Palestine availability","text":"YES. Palestinian MoH drug-price data list AEROVENT SOLUTION as ipratropium bromide. Verify the exact ward bottle/concentration.","id":"section-6-839a1639a06d327e"}],"legacyExams":[{"id":"ccu-ipratropium--standard","itemId":"ccu-ipratropium","itemType":"medication","title":"AEROVENT — ipratropium bromide","stage":"standard","reviewStatus":"authoring draft","passRule":{"operator":">=","percent":90,"roundBeforeComparison":false},"timing":{"timed":false,"secondsPerQuestion":null,"timerEnforcement":"persisted total deadline: 90 seconds multiplied by question count"},"scoring":{"correct":1,"incorrect":0,"unanswered":0,"partialCredit":false,"unsureOrGuessed":"review flag only","criticalSafetyMiss":"separate follow-up required; original numeric score unchanged"},"feedback":"show keys and all option explanations after submission","retestPolicy":"same standard form after required reading","questions":[{"format":"single-best-answer","stem":"What is the principal mechanism of action of AEROVENT — ipratropium bromide?","choices":[{"id":"A","text":"Reduces angiotensin-II formation","explanation":"This is a different pharmacological action. The drug’s action is: Airway muscarinic blockade produces bronchodilation."},{"id":"B","text":"Reduces vagal bronchoconstriction","explanation":"Airway muscarinic blockade produces bronchodilation."},{"id":"C","text":"Blocks fast sodium channels","explanation":"This is a different pharmacological action. The drug’s action is: Airway muscarinic blockade produces bronchodilation."},{"id":"D","text":"Inhibits Na-K-2Cl transport in the ascending loop","explanation":"This is a different pharmacological action. The drug’s action is: Airway muscarinic blockade produces bronchodilation."}],"point":"Identify the principal pharmacological action taught for this medicine.","criticalForSafety":false,"id":"ccu-ipratropium--standard--principal-action","points":1,"learningPointIds":["ccu-ipratropium::principal-action"],"answerKey":"B"},{"format":"single-best-answer","stem":"Which drug class does AEROVENT — ipratropium bromide belong to?","choices":[{"id":"A","text":"Methylxanthine","explanation":"The medicine is classified as: Inhaled antimuscarinic bronchodilator (SAMA)."},{"id":"B","text":"Short-acting beta2 agonist","explanation":"The medicine is classified as: Inhaled antimuscarinic bronchodilator (SAMA)."},{"id":"C","text":"Inhaled antimuscarinic","explanation":"Inhaled antimuscarinic bronchodilator (SAMA)."},{"id":"D","text":"Glucocorticoid","explanation":"The medicine is classified as: Inhaled antimuscarinic bronchodilator (SAMA)."}],"point":"Identify the drug class taught for this medicine.","criticalForSafety":false,"id":"ccu-ipratropium--standard--drug-class","points":1,"learningPointIds":["ccu-ipratropium::drug-class"],"answerKey":"C"},{"format":"single-best-answer","stem":"Which is a clinical use of AEROVENT — ipratropiu