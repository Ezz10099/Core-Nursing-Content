ole--comprehensive--treatment-role","points":1,"learningPointIds":["ccu-metronidazole::treatment-role"],"revision":"drug-dependent-20261106","sourceFields":["use"]},{"stem":"A patient taking FLAGYL — metronidazole reports new burning or numbness in the feet. Which drug-related concern is relevant?","choices":[{"id":"A","text":"Peripheral neuropathy","explanation":"New sensory symptoms can be a treatment-related warning."},{"id":"B","text":"Orthostatic hypotension","explanation":"This mainly produces symptoms associated with a postural pressure fall."},{"id":"C","text":"Gastrointestinal bleeding","explanation":"This does not best explain the new distal sensory pattern."},{"id":"D","text":"Acute dystonia","explanation":"This mainly produces abnormal sustained muscle postures."}],"format":"single-best-answer","point":"New sensory symptoms during susceptible treatment need review.","criticalForSafety":false,"id":"ccu-metronidazole--comprehensive--neuropathy","points":1,"learningPointIds":["ccu-metronidazole::neuropathy"],"answerKey":"A"},{"stem":"Which exposure needs review under metronidazole’s labeled precautions?","choices":[{"id":"A","text":"An iron-free vitamin C tablet","explanation":"This does not by itself identify alcohol or propylene glycol."},{"id":"B","text":"Alcohol or propylene-glycol-containing products","explanation":"The label includes avoidance during treatment and for its specified period afterward."},{"id":"C","text":"Plain drinking water","explanation":"It is not the exposure identified by the alcohol/propylene-glycol warning."},{"id":"D","text":"A saline nasal rinse","explanation":"This does not establish the relevant ingredient exposure."}],"format":"single-best-answer","point":"Follow labeled alcohol/propylene-glycol precautions with metronidazole.","criticalForSafety":false,"id":"ccu-metronidazole--comprehensive--metronidazole_alcohol","points":1,"learningPointIds":["ccu-metronidazole::metronidazole_alcohol"],"answerKey":"B"},{"format":"single-b