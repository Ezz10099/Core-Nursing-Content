
'use strict';const sampleMeds=[{"id": "norepinephrine", "name": "Norepinephrine", "alt": "Noradrenaline", "drugclass": "Catecholamine vasopressor; predominantly alpha1 with beta1 activity.", "availability": "Palestine availability: YES. The source documents 4-mg ampoules.", "use": "Vasopressor support for severe hypotension/shock when clinically indicated.", "administration": "Dilute to the hospital’s standardized concentration in a compatible IV fluid. Administer as a continuous infusion using an infusion pump; NEVER IV push. Central access is preferred for ongoing/concentrated therapy. An appropriate proximal peripheral line may be used short-term when urgent treatment should not be delayed.", "monitor": "Perform continuous or very frequent BP and perfusion assessment. Inspect a peripheral IV frequently. Use precise pump delivery: small rate changes can materially change BP.", "redflag": "If a peripheral site becomes painful, pale, swollen, cool, or stops flowing: stop using that site and escalate immediately.", "why": "Strong vasoconstriction raises systemic vascular resistance and MAP. Extravasation can cause severe local ischemia.", "source": "Used in CCU meds, original PDF pp. 55–57", "pages": "55–57", "question": "A peripheral norepinephrine site becomes pale, cool and painful. What is the next nursing action?", "options": ["Keep the infusion running and recheck later", "Stop using that IV site and escalate immediately", "Increase the pump rate"], "correct": 1, "explain": "The source specifically directs stopping use of the affected peripheral site and immediate escalation."}, {"id": "heparin", "name": "Heparin", "alt": "Unfractionated heparin (UFH)", "drugclass": "Unfractionated heparin anticoagulant.", "availability": "Palestine availability: YES. The source documents heparin 5,000 IU/mL in a 5-mL vial.", "use": "Therapeutic anticoagulation and selected prophylactic uses, depending on the order.", "administration": "May be SC or IV according to the order. Therapeutic IV infusion requires dilution to the hospital-standard concentration and a controlled infusion pump. Do NOT give IM. Do not confuse a concentrated treatment vial with a catheter-flush product.", "monitor": "Inspect for bleeding. Ensure ordered coagulation and platelet samples are drawn and abnormalities reported. Do not change an infusion rate independently unless an authorized nurse-driven unit protocol applies.", "redflag": "An unexpected platelet fall may signal heparin-induced thrombocytopenia (HIT); report and escalate.", "why": "UFH has a more variable anticoagulant effect than LMWH, so therapeutic infusions commonly need controlled delivery and laboratory follow-up.", "source": "Used in CCU meds, original PDF pp. 16–18", "pages": "16–18", "question": "A therapeutic IV heparin infusion is prescribed. Which approach matches the source?", "options": ["Give it IM", "Use a controlled infusion pump at the hospital-standard dilution", "Adjust the rate freely without an authorized protocol"], "correct": 1, "explain": "The source requires a controlled pump and hospital-standard dilution for therapeutic IV infusion."}, {"id": "atropine", "name": "Atropine", "alt": "Antimuscarinic", "drugclass": "Anticholinergic; specifically antimuscarinic.", "availability": "Palestine availability: YES. The source documents 1-mg ampoules.", "use": "Symptomatic bradycardia in the appropriate current resuscitation pathway.", "administration": "For symptomatic bradycardia: IV/IO bolus according to the applicable resuscitation protocol. It is not normally a continuous infusion.", "monitor": "Watch HR and rhythm immediately after administration. Dry mouth, reduced secretions, urinary retention and confusion can occur, especially in susceptible patients.", "redflag": "If instability persists, escalate along the bradycardia pathway instead of repeatedly relying on atropine alone.", "why": "Atropine removes the parasympathetic/vagal “brake”; it does not press the beta1 accelerator.", "source": "Used in CCU meds, original PDF pp. 64–66", "pages": "64–66", "question": "A patient remains unstable after atropine. What does the source emphasize?", "options": ["Keep relying on atropine alone", "Escalate along the bradycardia pathway", "Start a continuous atropine infusion routinely"], "correct": 1, "explain": "The source explicitly emphasizes escalating along the bradycardia pathway if instability persists."}];const meds=[{"id":"ccu-4","name":"VASOCORE — isosorbide mononitrate","header":"VASOCORE -isosorbide mononitrate","drugclass":"Organic nitrate; long-acting antianginal.","availability":"YES for the generic/form. Palestinian essential-medicine data document isosorbide mononitrate 20-mg tablets. “Vasocore” is the ward-reported trade spelling and should still be matched to the package.","administration":"PO; no dilution, IV line or pump. Give according to the ordered schedule. Do not substitute an extended-release product for an immediate-release product without checking the label.","use":"Prevention/control of angina. It is not the rapid-rescue formulation for an acute angina attack.","monitor":"• Check BP and dizziness before/after the dose because nitrate vasodilation can worsen hypotension. • Headache is common with nitrate therapy. • Never combine with sildenafil, tadalafil or vardenafil because the combination can cause profound hypotension/syncope. • Verify whether the local tablet is immediate- or modified-release because donated brands can differ.","why":"Nitrate vasodilation lowers preload/BP; this oral long-acting form is used for prevention rather than rapid rescue.","source":"Used in CCU meds","pages":"4–6","category":"ccu","memoryUse":"Prevention/control of angina.","memoryDanger":"Never combine with sildenafil, tadalafil or vardenafil because the combination can cause profound hypotension/syncope.","mechanism":"Nitric-oxide–mediated vasodilation relaxes vascular smooth muscle, reducing venous return (preload) and myocardial oxygen demand.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-7","name":"CORDIL — isosorbide dinitrate","header":"CORDIL -isosorbide dinitrate","drugclass":"Organic nitrate; antianginal.","availability":"YES for the generic/form. Palestinian essential-medicine data document isosorbide dinitrate 5-mg sublingual tablets. “Cordil” is the ward-reported trade name.","administration":"For the documented sublingual product, place the tablet under the tongue and let it dissolve. Do not prepare this tablet as an IV drug. Oral and sublingual formulations are not automatically interchangeable.","use":"Faster nitrate relief than long-acting oral isosorbide mononitrate. If the Kardex says an IV nitrate, verify the actual product; the Palestinian list separately documents IV nitroglycerin.","monitor":"• Check BP before and after use. • Headache and dizziness are common nitrate effects. • Ask specifically about Viagra/sildenafil or Cialis/tadalafil before administration. • Verify the route on the package because sublingual ISDN and IV nitrate products are different formulations.","why":"Route determines onset. Sublingual nitrate acts faster, while oral maintenance nitrate is used mainly for prevention.","source":"Used in CCU meds","pages":"7–9","category":"ccu","memoryUse":"Faster nitrate relief than long-acting oral isosorbide mononitrate.","memoryDanger":"Ask specifically about Viagra/sildenafil or Cialis/tadalafil before administration.","mechanism":"Releases nitric oxide to relax vascular smooth muscle; venodilation reduces preload and cardiac oxygen demand.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-10","name":"FRAXIPARINE / FRAXAPARIN — nadroparin","header":"FRAXIPARINE / FRAXAPARIN -nadroparin","drugclass":"Low-molecular-weight heparin (LMWH) anticoagulant.","availability":"WARD-REPORTED. You observed nadroparin locally, but a nadroparin entry was not located in the public 2024 Palestinian Essential Medicines List used by the original reference.","administration":"SC using the supplied prefilled syringe; never IM. Read the exact anti-Xa strength and volume from the syringe rather than memorizing one local strength.","use":"Anticoagulation in the same broad LMWH family as enoxaparin, but nadroparin is a different molecule/product.","monitor":"• Inspect for bleeding and bruising. • Review platelet results when ordered and report a significant fall; HIT is less common with LMWH than UFH but remains possible. • Renal impairment matters because LMWH can accumulate. • Do not substitute nadroparin and enoxaparin dose-for-dose simply because both are LMWH.","why":"LMWHs are related but not interchangeable; each product has its own concentration and validated dosing scheme.","source":"Used in CCU meds","pages":"10–12","category":"ccu","memoryUse":"Anticoagulation in the same broad LMWH family as enoxaparin, but nadroparin is a different molecule/product.","memoryDanger":"Inspect for bleeding and bruising.","mechanism":"Low-molecular-weight heparin enhances antithrombin activity, mainly inhibiting factor Xa and reducing clot formation.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-13","name":"CLEXANE / CLEXAN — enoxaparin","header":"CLEXANE / CLEXAN -enoxaparin","drugclass":"Low-molecular-weight heparin (LMWH) anticoagulant.","availability":"YES. Palestinian essential-medicine data document prefilled 20-, 40-, 60- and 80-mg syringes.","administration":"Deep SC in alternating abdominal sites. With a standard prefilled syringe, do not expel the manufacturer air bubble, and do not rub the injection site afterward.","use":"Anticoagulation in ACS and other thromboembolic indications according to the written order/protocol.","monitor":"• Watch gums, urine, stool, puncture sites and bruises for bleeding. • Check platelet and renal information when ordered. • Tell the team the most recent dose before invasive procedures or line removal when relevant. • Never give IM.","why":"Bleeding risk and renal clearance make exact product, syringe strength and timing clinically important.","source":"Used in CCU meds","pages":"13–15","category":"ccu","memoryUse":"Anticoagulation in ACS and other thromboembolic indications according to the written order/protocol.","memoryDanger":"Watch gums, urine, stool, puncture sites and bruises for bleeding.","mechanism":"Enhances antithrombin activity, mainly inhibiting factor Xa to reduce thrombin generation and clot formation.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"heparin","name":"HEPARIN — unfractionated heparin (UFH)","header":"HEPARIN -unfractionated heparin (UFH)","drugclass":"Unfractionated heparin anticoagulant.","availability":"YES. Palestinian essential-medicine data document heparin 5,000 IU/mL in a 5-mL vial.","administration":"May be SC or IV depending on the order. Therapeutic IV infusion requires a controlled infusion pump after dilution according to the hospital-standard concentration. Do not give IM. Never confuse a concentrated treatment vial with a catheter-flush product.","use":"Therapeutic anticoagulation and selected prophylactic uses depending on the order.","monitor":"• Inspect for bleeding. • Ensure ordered coagulation and platelet samples are actually drawn and abnormalities reported. • Do not independently change the infusion rate unless your unit uses an authorized nurse-driven protocol. • Recognize HIT as an important complication when platelets fall unexpectedly.","why":"UFH has a more variable anticoagulant effect than LMWH, so therapeutic infusions commonly require controlled delivery and laboratory follow-up.","source":"Used in CCU meds","pages":"16–18","category":"ccu","memoryUse":"Therapeutic anticoagulation and selected prophylactic uses depending on the order.","memoryDanger":"Recognize HIT as an important complication when platelets fall unexpectedly.","mechanism":"Enhances antithrombin inhibition of thrombin (IIa) and factor Xa, reducing fibrin clot formation.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-19","name":"ASA / ASPIRIN — aspirin","header":"ASA / ASPIRIN -aspirin","drugclass":"Antiplatelet; irreversible platelet COX-1 inhibitor.","availability":"YES. Palestinian essential-medicine data document 100-mg tablets.","administration":"PO. When an ACS loading dose is ordered, a rapid-release aspirin formulation is chewed rather than swallowed intact; an extended-release product is inappropriate when rapid action is needed.","use":"Antiplatelet therapy in ACS and secondary cardiovascular prevention.","monitor":"• Check active bleeding, GI-bleeding history and aspirin hypersensitivity. • Inspect stool, urine and puncture sites when aspirin is combined with other antithrombotics. • Recognize that aspirin + clopidogrel + heparin/LMWH substantially increases total bleeding tendency. • Do not duplicate ASA and aspirin; they are the same drug.","why":"Aspirin irreversibly reduces platelet aggregation, so combined antithrombotic therapy increases bleeding risk.","source":"Used in CCU meds","pages":"19–21","category":"ccu","memoryUse":"Antiplatelet therapy in ACS and secondary cardiovascular prevention.","memoryDanger":"Check active bleeding, GI-bleeding history and aspirin hypersensitivity.","mechanism":"Irreversibly inhibits platelet COX-1, lowering thromboxane A2 and platelet aggregation.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-22","name":"PLAVIX — clopidogrel","header":"PLAVIX -clopidogrel","drugclass":"P2Y12 antiplatelet.","availability":"YES. Palestinian essential-medicine and registry data document clopidogrel 75-mg tablets.","administration":"PO. Routine maintenance is straightforward with no dilution or infusion device. Loading doses, when needed, are separate physician/protocol orders.","use":"Commonly part of dual antiplatelet therapy after ACS/PCI and coronary stenting.","monitor":"• Assess for bleeding. • Do not casually omit or discontinue it in a patient with a recent coronary stent; clarify unexpected omissions. • Avoid routine omeprazole with clopidogrel when a suitable alternative PPI is available. • Pantoprazole is generally the less problematic practical PPI choice when acid suppression is needed.","why":"Premature interruption after stenting can increase thrombotic risk, while omeprazole can reduce clopidogrel activation.","source":"Used in CCU meds","pages":"22–24","category":"ccu","memoryUse":"Commonly part of dual antiplatelet therapy after ACS/PCI and coronary stenting.","memoryDanger":"Do not casually omit or discontinue it in a patient with a recent coronary stent; clarify unexpected omissions.","mechanism":"Irreversibly blocks platelet P2Y12 (ADP) receptors after metabolic activation, reducing platelet aggregation.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-25","name":"CONCOR / CONCORE — bisoprolol","header":"CONCOR / CONCORE -bisoprolol","drugclass":"Relatively beta1-selective beta-blocker.","availability":"YES. Palestinian essential-medicine data document a 5-mg tablet, and Concor 5 mg is registered in Palestine.","administration":"PO; no special preparation.","use":"Rate/BP control and reduction of cardiac workload in selected cardiovascular patients.","monitor":"• Check HR and BP before the dose. • Report symptomatic bradycardia, significant hypotension or new conduction problems rather than automatically giving the tablet. • Do not abruptly stop chronic therapy without an order. • Recognize duplicate beta-blockade if another beta-blocker such as metoprolol is also prescribed.","why":"Beta1 blockade slows HR and lowers cardiac workload/BP; abrupt withdrawal can produce sympathetic rebound.","source":"Used in CCU meds","pages":"25–27","category":"ccu","memoryUse":"Rate/BP control and reduction of cardiac workload in selected cardiovascular patients.","memoryDanger":"Report symptomatic bradycardia, significant hypotension or new conduction problems rather than automatically giving the tablet.","mechanism":"Selectively blocks cardiac beta1 receptors, slowing heart rate and reducing contractility and cardiac workload.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-28","name":"METCARDIUM — metoprolol","header":"METCARDIUM -metoprolol","drugclass":"Beta1-selective beta-blocker.","availability":"WARD-REPORTED for this trade name/form. The exact Metcardium salt/strength was not confirmed in the 2024 Palestinian Essential Medicines List used by the original reference.","administration":"Administer the ward-reported product exactly as labeled. Check whether the package says metoprolol tartrate or succinate; tablet formulations and modified-release products are not automatically interchangeable.","use":"Selected rate/BP control and reduction of myocardial workload.","monitor":"• Check HR and BP before administration. • Report marked bradycardia or hypotension. • Be cautious with verapamil because both can slow AV conduction. • Recognize duplicate beta-blocker therapy if bisoprolol is also on the Kardex.","why":"Metoprolol slows the heart through beta1 blockade; combining AV-node-slowing drugs can produce excessive bradycardia or block.","source":"Used in CCU meds","pages":"28–30","category":"ccu","memoryUse":"Selected rate/BP control and reduction of myocardial workload.","memoryDanger":"Report marked bradycardia or hypotension.","mechanism":"Blocks cardiac beta1 receptors, lowering heart rate, contractility and AV-node conduction.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-31","name":"PROPRANOLOL","header":"PROPRANOLOL","drugclass":"Nonselective beta1 + beta2 blocker.","availability":"YES. Palestinian essential-medicine data document 1-mg ampoules and 10- and 40-mg tablets.","administration":"Tablets PO. IV product should be administered slowly according to the ampoule/protocol with ECG and BP observation, not as an unmonitored rapid push.","use":"Selected cardiovascular indications such as rate control, angina or BP treatment depending on the patient and order.","monitor":"• Check HR and BP. • Ask about asthma or active bronchospasm. • Recognize that beta2 blockade can cause bronchoconstriction. • Remember that propranolol is less heart-selective than bisoprolol or metoprolol.","why":"Propranolol blocks both cardiac beta1 and bronchial beta2 receptors, so breathing matters as well as HR/BP.","source":"Used in CCU meds","pages":"31–33","category":"ccu","memoryUse":"Selected cardiovascular indications such as rate control, angina or BP treatment depending on the patient and order.","mechanism":"Blocks beta1 and beta2 adrenergic receptors, reducing cardiac stimulation; beta2 blockade can narrow airways.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-34","name":"AMICORE / AMICOR — amlodipine","header":"AMICORE / AMICOR -amlodipine","drugclass":"Dihydropyridine calcium-channel blocker; arterial vasodilator.","availability":"YES. Palestinian essential-medicine data document amlodipine 5-mg tablets, and AMICOR 5 mg is registered locally.","administration":"PO; no dilution or timing trick. It is not an emergency BP-rescue drug because its onset is gradual.","use":"Chronic BP control and antianginal therapy.","monitor":"• Check BP before the dose. • Look for ankle/peripheral edema. • Hypotension and dizziness can occur. • Do not automatically interpret amlodipine ankle edema as total-body fluid overload; assess the whole patient.","why":"Arteriolar dilation lowers BP but can increase capillary hydrostatic pressure in the ankles, causing peripheral edema.","source":"Used in CCU meds","pages":"34–36","category":"ccu","memoryUse":"Chronic BP control and antianginal therapy.","mechanism":"Blocks L-type calcium channels in vascular smooth muscle, dilating arterioles and lowering blood pressure.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-37","name":"IKACOR / IKAKOR — verapamil","header":"IKACOR / IKAKOR -verapamil","drugclass":"Non-dihydropyridine calcium-channel blocker; AV-node-slowing antiarrhy thmic/antianginal.","availability":"YES. Palestinian essential-medicine data document 5-mg ampoules and 40-mg tablets.","administration":"IV verapamil is a slow IV injection over at least 2 minutes under continuous ECG and BP monitoring. It is not a quick unmonitored push. Oral verapamil is a separate formulation.","use":"Selected supraventricular arrhythmias/rate control and antianginal therapy depending on the patient.","monitor":"• Watch HR, rhythm and BP. • Report bradycardia, AV block or significant hypotension. • Constipation is a common oral adverse effect. • Be very cautious when IV verapamil overlaps with beta-blockade.","why":"Verapamil slows AV-node conduction and myocardial activity, so combining it with another AV-node blocker can produce excessive depression.","source":"Used in CCU meds","pages":"37–39","category":"ccu","memoryUse":"Selected supraventricular arrhythmias/rate control and antianginal therapy depending on the patient.","memoryDanger":"Report bradycardia, AV block or significant hypotension.","mechanism":"Blocks L-type calcium channels in the AV node and myocardium, slowing AV conduction and reducing contractility.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-40","name":"ENALAPRIL","header":"ENALAPRIL","drugclass":"ACE inhibitor; RAAS blocker.","availability":"YES. Palestinian essential-medicine data document 5- and 20-mg tablets.","administration":"PO. Check the current BP and whether the patient is volume-depleted before giving.","use":"Chronic cardiovascular therapy for selected hypertension and heart-failure patients.","monitor":"• Monitor BP. • Follow potassium and renal function when ordered. • New lip, tongue or face swelling requires urgent escalation because ACE-inhibitor angioedema can obstruct the airway. • Previous ACE-inhibitor angioedema is a contraindication.","why":"ACE inhibition lowers angiotensin II/aldosterone, which lowers BP but can raise potassium and alter kidney function.","source":"Used in CCU meds","pages":"40–42","category":"ccu","memoryUse":"Chronic cardiovascular therapy for selected hypertension and heart-failure patients.","memoryDanger":"New lip, tongue or face swelling requires urgent escalation because ACE-inhibitor angioedema can obstruct the airway.","mechanism":"Inhibits angiotensin-converting enzyme, lowering angiotensin II and aldosterone; blood vessels relax and potassium retention can increase.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-43","name":"TROVAN / LIPIDEX / LIPDIX — atorvastatin","header":"TROVAN / LIPIDEX / LIPDIX - atorvastatin","drugclass":"Statin; HMG-CoA reductase inhibitor.","availability":"YES. Palestinian essential-medicine data support 20- and 40-mg atorvastatin options, and TROVAN 40 mg is registry-confirmed.","administration":"PO; no special bedside preparation. Continue consistently unless the written order or a clinical reason says otherwise.","use":"Secondary cardiovascular prevention, including after ACS.","monitor":"• Mild muscle symptoms can occur. • Severe unexplained muscle pain/weakness with or without dark urine is a useful rare red flag for myopathy/rhabdomyolysis. • Do not treat severe rhabdomyolysis as an expected everyday adverse effect. • Flag major new interacting antibiotics/antifungals rather than trying to memorize a giant interaction list.","why":"Higher atorvastatin exposure increases myopathy risk; its main CCU role is future cardiovascular risk reduction, not acute chest-pain relief.","source":"Used in CCU meds","pages":"43–45","category":"ccu","memoryUse":"Secondary cardiovascular prevention, including after ACS.","memoryDanger":"Severe unexplained muscle pain/weakness with or without dark urine is a useful rare red flag for myopathy/rhabdomyolysis.","mechanism":"Inhibits HMG-CoA reductase in the liver, reducing cholesterol synthesis and increasing LDL clearance.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-46","name":"LASIX — furosemide","header":"LASIX -furosemide","drugclass":"Loop diuretic.","availability":"YES. Palestinian essential-medicine data document a 20-mg ampoule, 40-mg tablet and 250-mg injectable presentation.","administration":"Routine IV doses are given slowly. Manufacturer labeling describes common IV doses over about 1-2 minutes, while high-dose parenteral therapy should use controlled infusion and avoid rates faster than about 4 mg/min.","use":"Pulmonary/peripheral congestion and fluid overload, including selected acute heart-failure patients.","monitor":"• Track urine output and congestion to assess response. • Check BP because volume loss can cause hypotension. • Follow K+, Mg2+, Na+ and renal function because loop diuresis can deplete electrolytes and change renal perfusion. • Report tinnitus or hearing change, especially during large/rapid IV doses. • Give routine oral doses earlier in the day when possible to reduce nocturia.","why":"Furosemide produces strong diuresis; rapid/high-dose IV administration increases electrolyte, volume and ototoxicity risk.","source":"Used in CCU meds","pages":"46–48","category":"ccu","memoryUse":"Pulmonary/peripheral congestion and fluid overload, including selected acute heart-failure patients.","memoryDanger":"Report tinnitus or hearing change, especially during large/rapid IV doses.","mechanism":"Blocks the Na-K-2Cl transporter in the thick ascending limb of the loop of Henle, increasing sodium and water excretion.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-49","name":"FARIGM — dapagliflozin","header":"FARIGM -dapagliflozin","drugclass":"SGLT2 inhibitor.","availability":"YES. Palestinian essential-medicine data document 10-mg tablets.","administration":"PO only; it has no acute glucose-correction role.","use":"Chronic therapy for diabetes, heart failure and kidney disease depending on the patient.","monitor":"• Watch volume status and BP because osmotic diuresis can contribute to dehydration. • Ask about genital or urinary symptoms because glucose-rich urine promotes infection. • In an acutely ill, fasting or NPO patient, verify whether the drug is intentionally being held. • Remember that euglycemic ketoacidosis can occur without very high blood glucose.","why":"SGLT2 blockade increases urinary glucose and sodium loss, which helps chronic disease but can contribute to dehydration and ketoacidosis risk.","source":"Used in CCU meds","pages":"49–51","category":"ccu","memoryUse":"Chronic therapy for diabetes, heart failure and kidney disease depending on the patient.","memoryDanger":"Remember that euglycemic ketoacidosis can occur without very high blood glucose.","mechanism":"Blocks renal SGLT2 glucose/sodium reabsorption, increasing urinary glucose and sodium excretion.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-52","name":"SLIDING-SCALE / CORRECTION INSULIN","header":"SLIDING-SCALE / CORRECTION INSULIN","drugclass":"High-alert insulin therapy; usually regular human insulin or a rapid-acting analogue for correction.","availability":"YES. Palestinian essential-medicine data include regular U-100 vials and rapid-acting U-100 pens, among other insulin formulations.","administration":"Correction insulin is normally SC using the currently ordered glucose-correction scale. IV insulin is a different protocol and requires a dedicated pump; never assume “sliding scale” means IV.","use":"Correction of hyperglycemia according to the current order/protocol.","monitor":"• Check current bedside glucose. • Verify the exact insulin name, U-100 concentration, dose and meal/NPO status. • Recheck glucose according to unit protocol. • Recognize hypoglycemia as the immediate major hazard. • Unopened insulin generally requires refrigeration at 2-8 C and must not freeze; in-use limits are product-specific.","why":"Insulin is high-alert because type, concentration and timing errors can cause severe hypoglycemia.","source":"Used in CCU meds","pages":"52–54","category":"ccu","memoryUse":"Correction of hyperglycemia according to the current order/protocol.","memoryDanger":"Recognize hypoglycemia as the immediate major hazard.","mechanism":"Insulin activates insulin receptors, increasing cellular glucose uptake and reducing hepatic glucose output.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"norepinephrine","name":"NOREPINEPHRINE / NORADRENALINE","header":"NOREPINEPHRIN E / NORADRENAL INE","drugclass":"Catecholamine vasopressor; predominantly alpha1 with beta1 activity.","availability":"YES. Palestinian essential-medicine data document 4-mg ampoules.","administration":"Dilute to the hospital’s standardized concentration in a compatible IV fluid and run as a continuous infusion on an infusion pump; never IV push. Central access is preferred for ongoing/concentrated therapy, but an appropriate proximal peripheral line may be used short-term when urgent treatment should not be delayed.","use":"Vasopressor support for severe hypotension/shock when clinically indicated.","monitor":"• Perform continuous or very frequent BP and perfusion assessment. • Inspect a peripheral IV frequently. • If a peripheral site becomes painful, pale, swollen, cool or stops flowing, stop using that site and escalate immediately. • Use precise pump delivery because small rate changes can materially change BP.","why":"Strong vasoconstriction raises systemic vascular resistance and MAP; extravasation can cause severe local ischemia.","source":"Used in CCU meds","pages":"55–57","category":"ccu","memoryUse":"Vasopressor support for severe hypotension/shock when clinically indicated.","memoryDanger":"If a peripheral site becomes painful, pale, swollen, cool or stops flowing, stop using that site and escalate immediately.","mechanism":"Stimulates mainly alpha1 receptors to constrict vessels and raise systemic vascular resistance and blood pressure.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-58","name":"DOBUTAMINE","header":"DOBUTAMINE","drugclass":"Predominantly beta1 inotrope.","availability":"YES. Palestinian essential-medicine data document 250-mg ampoules.","administration":"The concentrate must be diluted. Manufacturer information permits compatible solutions such as D5W or 0.9% NaCl. Use a continuous infusion pump, not an IV push. Exact bag volume/concentration should follow local protocol rather than a memorized fixed volume.","use":"Selected low-cardiac-output states such as severe acute heart failure/cardiogenic shock when increased contractility is needed.","monitor":"• Continuous ECG/HR and BP monitoring. • Follow urine output and peripheral perfusion. • Watch for tachycardia, ectopy and BP changes. • Peripheral administration can be used with close site monitoring; central access is preferable for concentrated/prolonged vasoactive therapy.","why":"Dobutamine increases cardiac contractility/output - think PUMP - but can also provoke tachyarrhythmia.","source":"Used in CCU meds","pages":"58–60","category":"ccu","memoryUse":"Selected low-cardiac-output states such as severe acute heart failure/cardiogenic shock when increased contractility is needed.","memoryDanger":"Watch for tachycardia, ectopy and BP changes.","mechanism":"Stimulates cardiac beta1 receptors, increasing myocardial contractility and cardiac output.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-61","name":"DOPAMINE","header":"DOPAMINE","drugclass":"Catecholamine inotrope/vasopressor with dose-dependent effects.","availability":"YES. Palestinian essential-medicine data document 200-mg ampoules.","administration":"Must be diluted before infusion and given continuously through an infusion pump; never IV push. Compatible fluids include commonly used dextrose/saline solutions. Avoid mixing it directly with strongly alkaline solutions such as sodium bicarbonate.","use":"Selected hemodynamic support and some bradycardia pathways depending on the clinical protocol.","monitor":"• Continuous HR, rhythm and BP monitoring. • Check urine output and peripheral perfusion. • Watch for tachyarrhythmia, excessive vasoconstriction and extravasation. • A large peripheral vein may be used initially with frequent inspection; central access is preferred for prolonged/concentrated infusion.","why":"Dopamine’s cardiovascular effects change with dose, and excessive exposure can become pro-arrhythmic or strongly vasoconstrictive.","source":"Used in CCU meds","pages":"61–63","category":"ccu","memoryUse":"Selected hemodynamic support and some bradycardia pathways depending on the clinical protocol.","memoryDanger":"Watch for tachyarrhythmia, excessive vasoconstriction and extravasation.","mechanism":"Stimulates dopamine and adrenergic receptors in a dose-dependent manner, changing cardiac output and vascular tone.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"atropine","name":"ATROPINE","header":"ATROPINE","drugclass":"Anticholinergic; specifically antimuscarinic.","availability":"YES. Palestinian essential-medicine data document 1-mg ampoules.","administration":"For symptomatic bradycardia, it is given as an IV/IO bolus according to the resuscitation protocol; it is not normally a continuous infusion.","use":"Symptomatic bradycardia in the appropriate current resuscitation pathway.","monitor":"• Watch HR and rhythm immediately after administration. • Dry mouth, reduced secretions, urinary retention and confusion can occur, especially in susceptible patients. • If instability persists, escalate along the bradycardia pathway rather than repeatedly relying on atropine alone.","why":"Atropine does not press the beta1 accelerator; it removes the parasympathetic/vagal brake.","source":"Used in CCU meds","pages":"64–66","category":"ccu","memoryUse":"Symptomatic bradycardia in the appropriate current resuscitation pathway.","memoryDanger":"If instability persists, escalate along the bradycardia pathway rather than repeatedly relying on atropine alone.","mechanism":"Blocks muscarinic receptors, removing vagal slowing of the SA and AV nodes and increasing heart rate.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-67","name":"PANTOVER / PANTOVERE — pantoprazole","header":"PANTOVER / PANTOVERE -pantoprazole","drugclass":"Proton-pump inhibitor (PPI).","availability":"WARD-REPORTED for pantoprazole by name. The Palestinian EML used by the original reference had broader 40-mg IV “PPI or alike” wording.","administration":"A common 40-mg IV vial is reconstituted with 10 mL 0.9% NaCl. Manufacturer labeling permits the reconstituted dose to be given slowly over at least 2 minutes or further diluted and infused over about 15 minutes. Verify the actual Pantover insert because brands can differ.","use":"Acid suppression, stress-ulcer prophylaxis or GI-bleeding therapy when ordered.","monitor":"• Flush and verify IV compatibility when sharing a line. • Watch persistent diarrhea during prolonged therapy. • When a PPI is required with clopidogrel, pantoprazole generally raises less CYP2C19 concern than omeprazole. • Use the actual product insert because IV brand instructions can differ.","why":"Pantoprazole suppresses gastric acid and generally interferes less with clopidogrel activation than omeprazole.","source":"Used in CCU meds","pages":"67–69","category":"ccu","memoryUse":"Acid suppression, stress-ulcer prophylaxis or GI-bleeding therapy when ordered.","mechanism":"Irreversibly inhibits the gastric proton pump (H+/K+-ATPase), suppressing stomach acid secretion.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-70","name":"OMEPRAZOLE","header":"OMEPRAZOLE","drugclass":"Proton-pump inhibitor (PPI).","availability":"YES. Palestinian essential-medicine data document a 20-mg oral tablet/capsule or equivalent.","administration":"Usually PO before food. Enteric-coated capsules/tablets should not simply be crushed unless the specific formulation permits it.","use":"Acid suppression and GI protection according to the indication.","monitor":"• Assess the ongoing GI indication. • Watch persistent diarrhea if therapy is prolonged. • Avoid routine pairing with clopidogrel when a suitable alternative PPI is available.","why":"Omeprazole inhibits CYP2C19, which clopidogrel needs for activation.","source":"Used in CCU meds","pages":"70–71","category":"ccu","memoryUse":"Acid suppression and GI protection according to the indication.","memoryDanger":"Avoid routine pairing with clopidogrel when a suitable alternative PPI is available.","mechanism":"Irreversibly inhibits the gastric proton pump (H+/K+-ATPase), reducing acid secretion.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-72","name":"FLAGYL — metronidazole","header":"FLAGYL -metronidazole","drugclass":"Nitroimidazole antib acterial/antiprotozoal; important anaerobic coverage.","availability":"YES. Palestinian essential-medicine data include IV 500 mg, 250/500-mg tablets and oral suspension.","administration":"Common 500-mg IV presentations are intermittent infusions rather than IV push. Use the supplied bag/bottle and its labeled infusion time, commonly about 30-60 minutes.","use":"Anaerobic and selected protozoal infections according to the infection diagnosis.","monitor":"• Nausea and metallic taste are common. • Report new numbness/tingling during prolonged courses because cumulative therapy can cause peripheral neuropathy. • Warfarin patients need closer INR attention because metronidazole can enhance anticoagulation. • Avoid alcohol/propylene-glycol products during therapy and for the labeled period afterward because a disulfiram-like reaction is possible.","why":"Metronidazole can interact with alcohol and warfarin, while prolonged exposure can cause neurologic toxicity.","source":"Used in CCU meds","pages":"72–74","category":"ccu","memoryUse":"Anaerobic and selected protozoal infections according to the infection diagnosis.","memoryDanger":"Report new numbness/tingling during prolonged courses because cumulative therapy can cause peripheral neuropathy.","mechanism":"Within susceptible anaerobes, reduced drug intermediates damage microbial DNA and inhibit nucleic-acid synthesis.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-75","name":"CEFTAZIDIME","header":"CEFTAZIDIME","drugclass":"Third-generation cephalosporin with important antipseudomonal activity.","availability":"YES. Palestinian essential-medicine data document 1-g vials.","administration":"For a 1-g vial, manufacturer instructions use 10 mL sterile water for IV reconstitution. Direct IV administration is slow over 3-5 minutes, or the reconstituted drug may be further diluted for intermittent infusion.","use":"Selected serious infections, including when antipseudomonal coverage is required.","monitor":"• Verify serious cephalosporin/beta-lactam allergy history. • Monitor for new severe diarrhea because antibiotic-associated C. difficile is possible. • Make sure renal impairment is known/reported because most ceftazidime is renally eliminated. • Use the exact vial and reconstitution instructions in hand.","why":"Renal accumulation increases toxicity risk, and immediate beta-lactam hypersensitivity can be life-threatening.","source":"Used in CCU meds","pages":"75–77","category":"ccu","memoryUse":"Selected serious infections, including when antipseudomonal coverage is required.","memoryDanger":"Verify serious cephalosporin/beta-lactam allergy history.","mechanism":"Binds penicillin-binding proteins and inhibits bacterial cell-wall synthesis.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-78","name":"LINEZOLID","header":"LINEZOLID","drugclass":"Oxazolidinone antibiotic.","availability":"WARD-REPORTED. You observed linezolid in Gaza, but no specific 2024 Palestinian EML entry was located in the original research.","administration":"A common IV formulation is a ready-to-use 600 mg/300 mL bag. Do not add medications to the bag. Give by calibrated infusion device over the product-specified infusion period rather than IV push.","use":"Mainly serious resistant Gram-positive infections, including MRSA/VRE, when prescribed.","monitor":"• Follow CBC/platelets, particularly when therapy approaches or exceeds 2 weeks. • Watch for thrombocytopenia and other reversible bone-marrow suppression. • Review serotonergic antidepressants/opioids and report agitation, hyperreflexia, fever or autonomic instability. • Longer courses also increase neuropathy risk.","why":"Linezolid can cause duration-related marrow suppression and has MAO-inhibiting activity that can contribute to serotonin syndrome.","source":"Used in CCU meds","pages":"78–80","category":"ccu","memoryUse":"Mainly serious resistant Gram-positive infections, including MRSA/VRE, when prescribed.","memoryDanger":"Review serotonergic antidepressants/opioids and report agitation, hyperreflexia, fever or autonomic instability.","mechanism":"Binds the bacterial 50S ribosomal subunit, blocking initiation of protein synthesis.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-81","name":"LEVOC / LEVOX — levofloxacin","header":"LEVOC / LEVOX -levofloxacin","drugclass":"Fluoroquinolone antibiotic.","availability":"YES. Palestinian essential-medicine data document 500-mg tablets and a 500-mg IV presentation.","administration":"Never IV push. A 500-mg IV dose is administered by slow infusion over at least 60 minutes. If the local product is a vial rather than a ready-to-use bag, follow that vial’s dilution instructions.","use":"Selected bacterial infections according to diagnosis and susceptibility considerations.","monitor":"• Watch BP during infusion because rapid administration can cause hypotension. • New tendon pain/swelling should be reported and the dose held pending review. • Renal impairment commonly changes the dosing interval. • Remember that levofloxacin can add QT risk in a patient who already has important QT risk factors.","why":"Slow infusion reduces hypotension risk, and renal clearance strongly affects exposure.","source":"Used in CCU meds","pages":"81–83","category":"ccu","memoryUse":"Selected bacterial infections according to diagnosis and susceptibility considerations.","memoryDanger":"New tendon pain/swelling should be reported and the dose held pending review.","mechanism":"Inhibits bacterial DNA gyrase and topoisomerase IV, disrupting DNA replication.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-84","name":"VENTOLIN — salbutamol / albuterol","header":"VENTOLIN -salbutamol / albuterol","drugclass":"Short-acting beta2 agonist (SABA) bronchodilator.","availability":"YES. Palestinian essential-medicine data document nebulizer solution 5 mg/mL and inhaler 100 mcg/inhalation; Palestinian product records also document Ventolin forms.","administration":"Inhaler by inhalation. For nebulization, measure the ordered dose and use the nebulizer solution as supplied or dilute with 0.9% NaCl when required by the device/order. It is not a routine IV medication.","use":"Relief of bronchospasm/wheeze in the appropriate respiratory patient.","monitor":"• Reassess work of breathing, wheeze and SpO2. • Monitor HR and tremor. • Repeated/high nebulized doses can lower K+. • Low potassium matters more when the patient is also receiving furosemide or already has hypokalemia.","why":"Beta2 stimulation bronchodilates but can also shift potassium into cells and produce tachycardia/tremor.","source":"Used in CCU meds","pages":"84–86","category":"ccu","memoryUse":"Relief of bronchospasm/wheeze in the appropriate respiratory patient.","mechanism":"Stimulates beta2 receptors in bronchial smooth muscle, relaxing airways; also shifts potassium into cells.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-87","name":"NYSTATIN","header":"NYSTATIN","drugclass":"Polyene antifungal; local oral therapy.","availability":"YES. Palestinian medicine data include an oral nystatin preparation; a common suspension strength is 100,000 units/mL.","administration":"Shake well, measure accurately, distribute around the mouth and retain it in the mouth as long as practical before swallowing. Avoid immediate food/drink when possible so contact time is not lost.","use":"Commonly used for oral candidiasis.","monitor":"• Inspect oral lesions and response. • Nausea, GI upset or oral irritation can occur. • Do not treat oral nystatin as therapy for systemic fungal infection. • Follow the local product storage label; avoid freezing and keep the bottle closed.","why":"Oral nystatin acts locally and is minimally absorbed.","source":"Used in CCU meds","pages":"87–89","category":"ccu","memoryUse":"Commonly used for oral candidiasis.","mechanism":"Binds fungal membrane ergosterol, forming pores and disrupting the membrane; oral preparations act mainly locally.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-90","name":"MEDIUM — betahistine","header":"MEDIUM -betahistine","drugclass":"Histamine analogue / antivertigo drug.","availability":"YES for betahistine 16-mg tablets. “Medium” is the ward-reported trade spelling and was not independently confirmed in the public Palestinian registry used by the original reference.","administration":"PO; taking it with or after food may reduce stomach upset.","use":"Symptomatic treatment of vertigo/dizziness rather than a primary cardiac emergency drug.","monitor":"• Common effects include nausea, dyspepsia and headache. • Use more caution with asthma or peptic-ulcer history. • Verify that the package actually says betahistine 16 mg because the trade spelling is ward-reported.","why":"This is a lower-priority chronic/symptom-control medicine in CCU compared with acute cardiac drugs.","source":"Used in CCU meds","pages":"90–92","category":"ccu","memoryUse":"Symptomatic treatment of vertigo/dizziness rather than a primary cardiac emergency drug.","mechanism":"Acts on histamine pathways (H1 agonism/H3 antagonism) involved in vestibular signaling; its exact clinical mechanism is not fully established.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-98","name":"PROFEX — propafenone","header":"PROFEX -propafenone","drugclass":"Class Ic sodium-channel-blocking antiarrhythmic.","availability":"WARD-REPORTED in your CCU for the exact trade product. Current manufacturer information supports PROFEX 150-mg and 300-mg oral tablets, but this update did not locate a current Palestinian public registry entry for that exact brand.","administration":"PO tablets. Verify the exact strength and schedule from the package and Kardex. This is not an IV emergency-trolley formulation. Dose selection and rhythm-control strategy are cardiology-directed.","use":"Rhythm control in carefully selected patients with arrhythmias such as atrial fibrillation/flutter, PSVT, and some ventricular arrhythmias. It is not appropriate for every AF patient.","monitor":"• Check HR, BP and rhythm/ECG when clinically indicated, especially during initiation or dose changes. • Hold/escalate for marked bradycardia, hypotension, new/worsening arrhythmia, important conduction slowing, or significant QRS widening. • Significant structural heart disease, recent myocardial infarction, heart failure, or important conduction disease can make Class Ic therapy unsafe; do not treat propafenone as a routine AF drug for every patient. • Review important electrolyte abnormalities and other drugs that slow conduction or affect rhythm. • Propafenone has some beta-blocking activity; bronchospasm risk matters in susceptible patients.","why":"It blocks fast cardiac sodium channels and slows conduction. That can suppress an arrhythmia, but the same effect can also create dangerous conduction or proarrhythmic problems.","source":"Used in CCU meds","pages":"98–101","category":"ccu","memoryUse":"Rhythm control in carefully selected patients with arrhythmias such as atrial fibrillation/flutter, PSVT, and some ventricular arrhythmias.","memoryDanger":"Hold/escalate for marked bradycardia, hypotension, new/worsening arrhythmia, important conduction slowing, or significant QRS widening.","mechanism":"Blocks fast cardiac sodium channels (Class Ic), slowing electrical conduction through the heart.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-102","name":"VALZADEPINE / Valzadipine — amlodipine + valsartan","header":"VALZADEPINE / \"Valzadipine\" -amlodipine + valsartan","drugclass":"Combination antihypertensive: dihydropyridine calcium-channel blocker (amlodipine) + angiotensin-II receptor blocker, ARB (valsartan).","availability":"YES. Valzadepine is a Palestinian Pharmacare product; Palestinian-market evidence supports amlodipine/valsartan combinations such as 5/80, 5/160 and 10/160 mg. Verify the exact strength on the ward package.","administration":"PO tablet. No IV preparation, dilution or pump. Give the exact ordered combination strength. Do not split the two components mentally into separate doses unless the prescriber has actually ordered separate products.","use":"Chronic hypertension treatment when one drug alone is not enough. In your CCU, you have also seen a different combination - valsartan + hydrochlorothiazide - used instead in some patients.","monitor":"• Check BP and symptoms of dizziness/hypotension. • Monitor renal function and potassium as ordered because valsartan can affect kidney function and raise K+. • Look for ankle/peripheral edema from the amlodipine component. • Avoid in pregnancy because valsartan acts on the renin-angiotensin system. • Do not assume valsartan + hydrochlorothiazide is the same medicine: it replaces amlodipine with a thiazide diuretic, so the expected effects and monitoring are different.","why":"Amlodipine relaxes arteries while valsartan blocks angiotensin-II effects. The combination lowers BP through two different mechanisms without adding a thiazide diuretic.","source":"Used in CCU meds","pages":"102–105","category":"ccu","memoryUse":"Chronic hypertension treatment when one drug alone is not enough.","memoryDanger":"Avoid in pregnancy because valsartan acts on the renin-angiotensin system.","mechanism":"Amlodipine blocks vascular L-type calcium channels to dilate arteries; valsartan blocks angiotensin-II AT1 receptors.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-106","name":"VALZAN HCT — valsartan + hydrochlorothiazide","header":"VALZAN HCT -valsartan + hydr ochlorothiazide","drugclass":"Combination antihypertensive: angiotensin-II receptor blocker (valsartan) + thiazide diuretic (hydrochlorothiazide, HCTZ).","availability":"YES. Palestinian Ministry of Health data list VALZAN-HCT as a local Pharmacare product; current Palestinian price data include valsartan 160 mg + hydrochlorothiazide 12.5 mg, and Palestinian product information also documents 80/12.5 and 160/25-mg strengths.","administration":"PO film-coated tablet. No IV preparation or pump. Give the exact ordered strength; do not assume one combination strength is interchangeable with another.","use":"Hypertension when monotherapy is insufficient. You report that this combination is sometimes given in your CCU instead of Valzadepine. That is a ward treatment choice, not a dose-for-dose substitution.","monitor":"• Check BP and assess for dizziness/orthostatic symptoms. • Follow renal function and electrolytes, especially Na+ and K+, when ordered. • Hydrochlorothiazide can lower Na+ and K+ and cause volume depletion; valsartan can raise K+, so the final potassium effect cannot be safely guessed. • Watch hydration/volume status, especially if the patient is also receiving another diuretic. • Avoid in pregnancy because valsartan can injure the fetus. • Do not confuse it with Valzadepine: Valzan HCT = valsartan + HCTZ; Valzadepine = valsartan + amlodipine.","why":"Valsartan blocks angiotensin-II while HCTZ increases sodium/water excretion. Unlike Valzadepine, this combination includes a diuretic instead of amlodipine.","source":"Used in CCU meds","pages":"106–109","category":"ccu","memoryUse":"Hypertension when monotherapy is insufficient.","memoryDanger":"Avoid in pregnancy because valsartan can injure the fetus.","mechanism":"Valsartan blocks angiotensin-II AT1 receptors; hydrochlorothiazide blocks distal-tubule Na-Cl transport, increasing sodium/water excretion.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-110","name":"SYMBICORT — budesonide + formoterol","header":"SYMBICORT -budesonide + formoterol","drugclass":"Inhaled corticosteroid (ICS) + long-acting beta2 agonist (LABA).","availability":"YES. The Palestinian Ministry of Health registry lists SYMBICORT TURBUHALER 160/4.5 mcg per inhalation in 60- and 120-dose inhalers; the registration shown is current through 2030.","administration":"Inhaled dry-powder Turbuhaler. For this device, the patient should inhale forcefully and deeply through the mouthpiece and should not breathe out through it. After the maintenance dose, rinse the mouth with water. Use the exact prescribed regimen; some asthma plans use budesonide/formoterol as maintenance plus reliever, while other patients use it only as maintenance.","use":"Ongoing asthma or COPD treatment in a CCU patient with chronic respiratory disease. It is not an IV or nebulized CCU drug. If respiratory symptoms are acutely worsening, reassess the patient rather than assuming the routine inhaler alone is enough.","monitor":"• Check that the patient can use the inhaler correctly; poor technique can make an effective drug look ineffective. • Rinse the mouth after maintenance inhalations to reduce oral candidiasis/thrush and hoarseness. • Monitor for tremor, palpitations or tachycardia from the formoterol component, especially in a cardiac patient. • Rare red flag: immediate worsening wheeze/bronchospasm after inhalation - stop and escalate. • If the patient is needing more reliever treatment or symptoms are worsening, treat that as deterioration requiring reassessment.","why":"Budesonide reduces airway inflammation; formoterol relaxes bronchial smooth muscle. The combination controls inflammation and bronchodilation in one inhaler.","source":"Used in CCU meds","pages":"110–114","category":"ccu","memoryUse":"Ongoing asthma or COPD treatment in a CCU patient with chronic respiratory disease.","memoryDanger":"Rare red flag: immediate worsening wheeze/bronchospasm after inhalation - stop and escalate.","mechanism":"Budesonide activates glucocorticoid receptors to reduce airway inflammation; formoterol stimulates beta2 receptors to relax bronchial muscle.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-115","name":"GENTAMICIN","header":"GENTAMICIN","drugclass":"Aminoglycoside antibiotic.","availability":"YES. Palestinian essential-medicine data list gentamicin 80-mg injection, and the Palestinian pharmacy registry currently lists Gentamicin Panpharma 80 mg/2 mL.","administration":"IV infusion or IM, depending on the order and product. A current 80 mg/2 mL (40 mg/mL) injection label states that it must be diluted for IV use. Product labeling for intermittent IV administration allows dilution in compatible saline or D5W and infusion over about 30 minutes to 2 hours; follow the exact local product and hospital protocol rather than memorizing one bag volume.","use":"Treatment of serious susceptible bacterial infections, especially Gram-negative infection, when selected by the treating team. In CCU this may appear in patients with severe infection/sepsis or another infection requiring aminoglycoside coverage.","monitor":"• Check renal function before and during therapy; impaired renal clearance markedly increases toxicity risk. • Gentamicin dosing often needs renal adjustment. Do not independently alter the dose; ensure the prescriber/pharmacy has the current renal data. • Monitor serum gentamicin levels when ordered/available, especially with repeated therapy or renal impairment. • Watch for ototoxicity: tinnitus, hearing change, dizziness or vertigo. Aminoglycoside ototoxicity can be irreversible. • Watch for nephrotoxicity: rising creatinine or falling urine output, and report deterioration promptly. • Avoid casual physical premixing with other drugs in the same syringe/bag unless compatibility is specifically confirmed.","why":"Gentamicin is cleared mainly by the kidneys and has a narrow safety margin; accumulation can injure the kidneys and the vestibular/auditory system.","source":"Used in CCU meds","pages":"115–119","category":"ccu","memoryUse":"Treatment of serious susceptible bacterial infections, especially Gram-negative infection, when selected by the treating team.","memoryDanger":"Watch for nephrotoxicity: rising creatinine or falling urine output, and report deterioration promptly.","mechanism":"Binds the bacterial 30S ribosomal subunit, disrupting protein synthesis and causing bacterial killing.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-120","name":"AEROVENT — ipratropium bromide","header":"AEROVENT -ipratropium bromide","drugclass":"Inhaled antimuscarinic bronchodilator (short-acting muscarinic antagonist, SAMA).","availability":"YES. The Palestinian Ministry of Health drug-price database lists AEROVENT SOLUTION with the generic name ipratropium bromide. Public product information for Aerovent respirator solution identifies a 0.25 mg/mL inhalation solution; verify the exact ward bottle before use.","administration":"Nebulized/inhaled respirator solution; not IV. Give the exact ordered dose using the nebulizer/device. It may be used together with an inhaled beta2 agonist such as salbutamol when ordered for acute bronchospasm. Do not assume one dilution volume across products.","use":"Bronchodilation in patients with bronchospasm, especially COPD and some asthma exacerbations. In the CCU it may be encountered when a cardiac patient also has obstructive airway disease or acute wheeze.","monitor":"• Reassess work of breathing, wheeze, respiratory rate and SpO2 after treatment. • Dry mouth and throat irritation can occur. • Avoid directing nebulized mist into the eyes; antimuscarinic exposure can worsen acute angle-closure glaucoma in susceptible patients. • Use caution in patients prone to urinary retention. • If respiratory distress is worsening, do not rely on the routine nebulizer alone - reassess and escalate.","why":"Ipratropium blocks muscarinic vagal bronchoconstriction, so airway smooth muscle relaxes and airflow improves.","source":"Used in CCU meds","pages":"120–123","category":"ccu","memoryUse":"Bronchodilation in patients with bronchospasm, especially COPD and some asthma exacerbations.","memoryDanger":"Avoid directing nebulized mist into the eyes; antimuscarinic exposure can worsen acute angle-closure glaucoma in susceptible patients.","mechanism":"Blocks muscarinic receptors in airway smooth muscle, reducing vagal bronchoconstriction.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-124","name":"ADENOSINE","header":"ADENOSINE","drugclass":"Ultra-short-acting AV-nodal blocking antiarrhythmic.","availability":"YES. The Palestinian Essential Medicine List documents adenosine 6-mg ampoules.","administration":"Rapid IV push followed immediately by a rapid normal-saline flush, with continuous ECG monitoring. Use a port as close to the patient as practical. Current AHA adult tachyarrhythmia guidance uses 6 mg rapid IV first, then 12 mg if required. Do not give it as a slow injection through long tubing.","use":"Primarily for stable regular narrow-complex SVT. Current AHA guidance also allows consideration in selected stable regular monomorphic wide-complex tachycardia. Unstable tachyarrhythmia requires the instability pathway and synchronized cardioversion rather than delaying definitive treatment.","monitor":"• Continuous ECG/rhythm monitoring is essential during administration. • Warn a conscious patient that flushing, chest pressure, breathlessness or a brief frightening pause sensation may occur. • Be prepared for transient AV block or very brief asystole. • Bronchospasm can occur; asthma or active bronchospasm is an important safety concern. • Methylxanthines such as theophylline/aminophylline can reduce adenosine effect, while dipyridamole can increase it. • Because the drug disappears from the circulation within seconds, technique matters as much as the prescribed dose.","why":"Adenosine is cleared within seconds. The rapid push plus immediate flush gets enough drug to the AV node before it is metabolized.","source":"Used in CCU meds","pages":"124–127","category":"ccu","memoryUse":"Primarily for stable regular narrow-complex SVT.","memoryDanger":"Bronchospasm can occur; asthma or active bronchospasm is an important safety concern.","mechanism":"Briefly activates adenosine A1 receptors in the AV node, transiently slowing or blocking AV conduction.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-128","name":"LABETALOL","header":"LABETALOL","drugclass":"Combined alpha1-and beta-adrenergic blocker; antihypertensive.","availability":"YES. Palestinian Essential Medicines records include a 100-mg injection ampoule and 100- and 200-mg tablets. Confirm the actual ward product and concentration.","administration":"PO tablets or IV injection/controlled infusion, depending on the order and product. For a verified 5 mg/mL IV formulation, official labeling describes slow IV dosing over 2 minutes with BP reassessment; infusion requires a controlled pump. Do not copy this IV schedule to a different product without checking its label.","use":"Controlled BP lowering for selected severe hypertension or other physician-directed cardiovascular indications. Also appears in the CCU emergency-trolley reference; its presence here records your CCU clinical exposure.","monitor":"• Check BP, HR and rhythm before and after IV doses; reassess for symptomatic hypotension. • Hold and urgently clarify if severe bradycardia, important AV block, cardiogenic shock or overt heart failure is present. • Bronchial asthma is a contraindication for the referenced injectable formulation because beta2 blockade may provoke bronchospasm. • Check other BP-lowering and AV-node-slowing drugs on the Kardex to anticipate additive effects.","why":"Alpha1 blockade dilates vessels and beta blockade reduces adrenergic cardiac effects; BP and HR both need monitoring.","source":"Used in CCU meds","pages":"128–131","category":"ccu","memoryUse":"Controlled BP lowering for selected severe hypertension or other physician-directed cardiovascular indications.","memoryDanger":"Hold and urgently clarify if severe bradycardia, important AV block, cardiogenic shock or overt heart failure is present.","mechanism":"Blocks alpha1 receptors to dilate vessels and beta receptors to reduce adrenergic cardiac stimulation.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-132","name":"KETAMINE — ketamine hydrochloride","header":"KETAMINE — ketamine hydrochloride","drugclass":"Dissociative anesthetic; NMDA-receptor antagonist.","availability":"YES. The Palestinian Essential Medicines List records ketamine HCl injection, 500 mg total. That is vial content, not a universal concentration; read the actual product label.","administration":"IV or IM according to the prescribed indication. Official labeling for IV anesthetic induction specifies slow administration, about 60 seconds; rapid administration can cause respiratory depression and an excessive pressor response. Concentration, dilution and any infusion setup are product- and order-specific. Sedation/anesthesia requires authorized trained staff, full monitoring and immediately available airway/ventilation equipment.","use":"Physician-directed procedural sedation or anesthetic induction when indicated; the exact reason in your CCU patient must be read from the order and clinical record.","monitor":"• Check BP, HR, SpO2, breathing, consciousness and ECG as appropriate; reassess throughout sedation and recovery. • Airway obstruction, laryngospasm or apnea can occur. Have suction, oxygen, BVM and resuscitation support ready even though spontaneous breathing may be preserved. • Ketamine can raise BP and HR, but hypotension and cardiac decompensation can also occur; flag cases where a large BP rise would be dangerous. • Confusion, vivid dreams or agitation can occur during emergence; monitor recovery and provide a calm environment. • Combining with opioids or benzodiazepines increases sedation and respiratory-depression risk.","why":"NMDA blockade causes dissociative anesthesia; airway and hemodynamic monitoring remain essential.","source":"Used in CCU meds","pages":"132–136","category":"ccu","memoryUse":"Physician-directed procedural sedation or anesthetic induction when indicated; the exact reason in your CCU patient must be read from the order and clinical record.","memoryDanger":"Airway obstruction, laryngospasm or apnea can occur. Have suction, oxygen, BVM and resuscitation support ready even though spontaneous breathing may be preserved.","mechanism":"Blocks NMDA receptors, producing dissociative anesthesia and analgesia.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-137","name":"PETHIDINE — meperidine","header":"PETHIDINE — meperidine","drugclass":"Opioid analgesic.","availability":"YES. Palestinian Essential Medicines data list pethidine injection in 50-and 100-mg ampoules. These figures are total ampoule amounts; verify the actual concentration and route.","administration":"IM, SC or IV according to the product and order. If IV use is necessary, official meperidine labeling requires very slow administration, preferably diluted, with the patient monitored and naloxone plus assisted ventilation immediately available. Do not convert ampoule content into a default dose or give a rapid IV push.","use":"Physician-prescribed analgesia for selected severe pain situations. This is not a routine first-choice treatment for every CCU chest-pain patient; assess the cause of pain and follow the actual order.","monitor":"• Check pain, sedation, RR, SpO2 and BP before administration and reassess after; stop/escalate if breathing or consciousness deteriorates. • Nausea, vomiting, dizziness, sedation and hypotension can occur. • Avoid routine/repeated use when renal function is impaired: its metabolite normeperidine can accumulate and increase seizure risk. • Check for recent MAO-inhibitor use and other serotonergic/CNS-de pressant medications before administration; serious interactions may occur. • Follow controlled-drug documentation, secure storage and witnessed-waste requirements under local policy.","why":"It is an opioid, so respiratory depression is the immediate danger; normeperidine accumulation is a distinct seizure risk.","source":"Used in CCU meds","pages":"137–140","category":"ccu","memoryUse":"Physician-prescribed analgesia for selected severe pain situations.","memoryDanger":"Check pain, sedation, RR, SpO2 and BP before administration and reassess after; stop/escalate if breathing or consciousness deteriorates.","mechanism":"Activates mu-opioid receptors in the CNS, reducing pain signaling and respiratory drive.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ccu-141","name":"MORPHINE — morphine sulfate / hydrochloride","header":"MORPHINE — morphine sulfate / hydrochloride","drugclass":"Strong opioid analgesic.","availability":"YES. Palestinian essential-medicine records include a 10-mg morphine ampoule. Verify salt, concentration, route and ordered dose on the product in hand.","administration":"IV or IM injection as appropriate to the actual prescribed product; IV morphine is given slowly and titrated under close monitoring, not as an unmonitored rapid bolus. Different injectable formul ations/concentrations may not have identical instructions; use the exact label and order. Keep naloxone and airway support available.","use":"Selected severe pain or distress management when prescribed, including some CCU patients after a clinical assessment. It is not automatically indicated for every ACS patient or every case of pulmonary edema.","monitor":"• Assess pain, RR, SpO2, level of consciousness and BP before and after doses; sedation can precede respiratory depression. • Hold/escalate for significant respiratory depression, severe hypotension or reduced consciousness. Support airway/ventilation and follow the naloxone protocol if opioid toxicity is suspected. • Nausea, vomiting, constipation, pruritus and dizziness can occur. • Morphine may worsen hypotension in shock; assess hemodynamic status before administration. • Opioids with benzodiazepines or other sedatives can cause profound sedation and respiratory depression; check concurrent medications. • Use controlled-drug count, documentation and waste procedures according to local policy.","why":"Mu-opioid receptor activation relieves severe pain but also reduces respiratory drive and can lower BP.","source":"Used in CCU meds","pages":"141–145","category":"ccu","memoryUse":"Selected severe pain or distress management when prescribed, including some CCU patients after a clinical assessment.","memoryDanger":"Hold/escalate for significant respiratory depression, severe hypotension or reduced consciousness. Support airway/ventilation and follow the naloxone protocol if opioid toxicity is suspected.","mechanism":"Activates mu-opioid receptors, reducing pain perception and respiratory drive.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"trolley-3","name":"SPIRONOLACTONE — Aldactone","header":"SPIRONOLACTONE -Aldactone","drugclass":"Potassium-sparing diuretic; mineralocorticoid-receptor antagonist.","availability":"YES. Palestine-wide records show SPIRONE 25-mg and 100-mg tablets. Aldactone is a familiar trade name, but the exact brand on the ward can differ.","administration":"PO tablets. There is no routine IV emergency formulation. No reconstitution, IV line or pump is involved. Give the exact ordered tablet strength.","use":"Mainly chronic/subacute therapy in heart failure, resistant hypertension and aldosterone-mediated fluid retention; it is not the rapid-diuresis rescue role of IV furosemide.","monitor":"• Check potassium and renal function. Hyperkalemia is the major actionable electrolyte hazard, especially with renal impairment. • Escalate significant hyperkalemia or worsening renal function before routine administration. • Watch for hypotension, dizziness and dehydration, especially with other diuretics or RAAS-blocking drugs. • Do not casually add potassium supplements or potassium-containing salt substitutes without reviewing the indication and labs.","why":"Spironolactone saves potassium; furosemide tends to waste potassium.","source":"Emergency trolley meds","pages":"3–5","category":"trolley","memoryUse":"","memoryDanger":"Escalate significant hyperkalemia or worsening renal function before routine administration.","mechanism":"Blocks aldosterone (mineralocorticoid) receptors in the distal nephron, increasing sodium excretion while retaining potassium.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"trolley-6","name":"LIDOCAINE HCl","header":"LIDOCAINE HCl","drugclass":"Class IB ventricular antiarrhythmic; also a local anesthetic.","availability":"YES. Palestinian essential-medicine data document lidocaine HCl injection in 1%, 2% and 4% presentations, with Palestinian products also located.","administration":"Before IV cardiac use, verify the product is intended for IV antiarrhythmic use and does not contain epinephrine or another local-anesthetic additive. For perfusing ventricular arrhythmias, manufacturer labeling describes 1-1.5 mg/kg IV at about 25-50 mg/min, followed when needed by a controlled infusion typically 1-4 mg/min. Continuous ECG monitoring is required.","use":"AHA continues to allow lidocaine or amiodarone for shock-refractory VF/pulseless VT. In cardiac arrest, follow the ACLS arrest algorithm rather than automatically applying a non-arrest slow-injection schedule.","monitor":"• Continuous ECG during IV antiarrhythmic use; worsening conduction, QRS widening, bradycardia or new arrhythmia needs immediate reassessment. • Watch for neurologic toxicity: perioral numbness, confusion, drowsiness, tinnitus, twitching or seizures. • Hypotension, myocardial depression, bradycardia, heart block and respiratory depression can occur with excessive systemic exposure. • Prolonged infusion can accumulate when clearance is reduced; infusion requirements need reassessment over time.","why":"Lidocaine affects cardiac sodium channels; systemic toxicity often appears first as neurologic or conduction changes.","source":"Emergency trolley meds","pages":"6–8","category":"trolley","memoryUse":"AHA continues to allow lidocaine or amiodarone for shock-refractory VF/pulseless VT.","memoryDanger":"Watch for neurologic toxicity: perioral numbness, confusion, drowsiness, tinnitus, twitching or seizures.","mechanism":"Blocks voltage-gated sodium channels, suppressing ventricular electrical activity; also blocks nerve impulse conduction.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"trolley-9","name":"SODIUM BICARBONATE","header":"SODIUM BICARBONATE","drugclass":"Systemic alkalinizing agent.","availability":"YES. Palestinian MoH essential-medicine data document sodium bicarbonate 8.4%, 100-mL ampoule. Common international 8.4% products are 1 mEq/mL, but container volume can differ.","administration":"IV. The 8.4% adult emergency formulation is highly concentrated. Do not convert percentage, mL and mEq from memory. Administration and dilution vary by indication; use the actual product insert plus the indication-specific protocol.","use":"AHA does not support routine sodium bicarbonate in ordinary undifferentiated cardiac arrest. Its role is mainly in selected reversible causes/special circumstances.","monitor":"• Verify indication, concentration and ordered mEq before drawing it up. • Follow sodium, pH/ABG or VBG and potassium when clinically indicated; excessive bicarbonate can cause alkalemia, hypernatremia and sodium/volume load. • Use a clearly identified line; do not improvise Y-site mixing with another emergency drug unless exact compatibility is confirmed. • It is not a substitute for high-quality CPR, defibrillation, ventilation when indicated, or treatment of the underlying cause.","why":"It changes acid-base chemistry; without a specific indication it can add sodium/alkali without fixing the cause.","source":"Emergency trolley meds","pages":"9–11","category":"trolley","memoryUse":"AHA does not support routine sodium bicarbonate in ordinary undifferentiated cardiac arrest.","memoryDanger":"It is not a substitute for high-quality CPR, defibrillation, ventilation when indicated, or treatment of the underlying cause.","mechanism":"Provides bicarbonate buffer to shift acid–base balance; it does not itself remove the cause of acidosis.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"trolley-12","name":"LABETALOL","header":"LABETALOL","drugclass":"Combined alpha1- and beta-adrenergic blocker.","availability":"YES. Palestinian documentation shows 100-mg ampoules and 100/200-mg tablets. A 5 mg/mL, 20-mL ampoule equals 100 mg total.","administration":"For the standard 5 mg/mL injection, manufacturer labeling permits repeated IV injection or continuous infusion. A commonly labeled initial dose is 20 mg slowly over 2 minutes, followed if ordered by 40- or 80-mg doses at 10-minute intervals to response. BP is checked before treatment and after IV dosing. Continuous infusion, when used, requires a controlled device.","use":"Useful IV antihypertensive when rapid but controlled BP reduction is required, especially when excessive sympathetic tachycardia is also undesirable.","monitor":"• Check BP, HR and rhythm before and after IV doses. • Hold/escalate for severe bradycardia, cardiogenic shock, overt heart failure or significant AV block. • Bronchial asthma is a labeled contraindication because beta2 blockade may trigger bronchospasm. • Monitor for symptomatic hypotension after IV treatment, especially with position changes.","why":"It lowers pressure through both alpha1 vasodilation and beta blockade, so HR and bronchospasm risk matter as much as BP.","source":"Emergency trolley meds","pages":"12–14","category":"trolley","memoryUse":"Useful IV antihypertensive when rapid but controlled BP reduction is required, especially when excessive sympathetic tachycardia is also undesirable.","memoryDanger":"Hold/escalate for severe bradycardia, cardiogenic shock, overt heart failure or significant AV block.","mechanism":"Blocks alpha1 receptors to dilate vessels and beta receptors to reduce cardiac adrenergic effects.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"trolley-15","name":"HYDRALAZINE","header":"HYDRALAZINE","drugclass":"Direct arterial vasodilator.","availability":"YES. Palestinian essential-medicine data document 20-mg ampoules and 50-mg tablets.","administration":"Current injectable products are commonly 20 mg/mL in a 1-mL vial for IV or IM use and are ready solution rather than powder. Because a universal IV-push time was not sufficiently clear across products, use slow IV according to the exact ampoule insert/local protocol rather than memorizing an invented rate.","use":"Parenteral treatment of severe hypertension; frequent reassessment is important because response is not continuously titratable like a dedicated infusion.","monitor":"• Check BP before and repeatedly after parenteral administration. • Watch for headache, flushing, dizziness, hypotension and reflex tachycardia. • Escalate new chest discomfort or marked tachycardia in a coronary patient. • Do not confuse it with labetalol: hydralazine can increase reflex HR, while labetalol generally suppresses beta-mediated tachycardia.","why":"Direct arteriolar dilation can drop BP quickly and trigger reflex sympathetic tachycardia.","source":"Emergency trolley meds","pages":"15–16","category":"trolley","memoryUse":"Parenteral treatment of severe hypertension; frequent reassessment is important because response is not continuously titratable like a dedicated infusion.","memoryDanger":"Escalate new chest discomfort or marked tachycardia in a coronary patient.","mechanism":"Directly relaxes arteriolar smooth muscle, lowering peripheral vascular resistance and blood pressure.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"trolley-17","name":"DEXTROSE 50% — D50","header":"DEXTROSE 50% - D50","drugclass":"Hypertonic IV glucose.","availability":"YES. Palestinian documentation includes dextrose 50%, 500 mL. A Palestinian 25-g/50-mL emergency syringe was not independently confirmed; therefore D50 means 50% concentration, not automatically a 50-mL syringe.","administration":"IV only for the concentrated emergency product. D50 is markedly hypertonic. Ensure a clearly patent IV, preferably a good large peripheral vein for a single emergency dose, and stop if infiltration/extravasation is suspected. A ready syringe/vial needs no reconstitution; verify the actual grams and volume on the container.","use":"High relevance: severe symptomatic hypoglycemia when IV glucose is indicated.","monitor":"• Check bedside glucose immediately unless treatment cannot safely wait. • Confirm concentration and grams, not merely the label \"D50.\" • Recheck glucose after treatment and reassess consciousness; the cause of hypoglycemia may persist. • Watch the IV site for pain, swelling or loss of flow; extravasation of concentrated dextrose can injure tissue. • In an unconscious patient, protect the airway while treating the glucose problem.","why":"D50 rapidly raises blood glucose, but because it is very hypertonic it can damage tissue if it leaves the vein.","source":"Emergency trolley meds","pages":"17–19","category":"trolley","memoryUse":"High relevance: severe symptomatic hypoglycemia when IV glucose is indicated.","memoryDanger":"Watch the IV site for pain, swelling or loss of flow; extravasation of concentrated dextrose can injure tissue.","mechanism":"Provides concentrated glucose directly into the bloodstream, rapidly raising blood glucose.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"trolley-20","name":"HYDROCORTISONE","header":"HYDROCORTISONE","drugclass":"Glucocorticoid.","availability":"YES. Palestinian essential-medicine data document a 100-mg vial.","administration":"The exact salt matters; emergency products are commonly hydrocortisone sodium succinate. For the researched Solu-Cortef 100-mg product, the Act-O-Vial yields 100 mg in 2 mL; the label permits IV injection, IV infusion or IM administration, with IV preferred initially in emergencies. The specific label describes a 100-mg IV dose over about 30 seconds. Do not copy that reconstitution to a different product without its insert.","use":"Important for adrenal crisis and selected severe inflammatory/allergic or shock states when indicated. In anaphylaxis it is an adjunct and must not delay epinephrine.","monitor":"• Verify the salt and vial strength before reconstituting. • Monitor BP, glucose and clinical response; corticosteroids can raise glucose and contribute to sodium/fluid retention. • With repeated/high-dose therapy, follow electrolytes and infection risk as clinically appropriate. • Do not let hydrocortisone delay the first-line lifesaving treatment for the actual emergency.","why":"Steroids change inflammatory and stress responses; their benefit is diagnosis-specific and is not immediate cardiac resuscitation.","source":"Emergency trolley meds","pages":"20–22","category":"trolley","memoryUse":"Important for adrenal crisis and selected severe inflammatory/allergic or shock states when indicated.","memoryDanger":"Do not let hydrocortisone delay the first-line lifesaving treatment for the actual emergency.","mechanism":"Activates glucocorticoid receptors to change gene expression, supporting stress responses and reducing inflammation.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"trolley-23","name":"ISOSORBIDE DINITRATE — SL tablet and IV question","header":"ISOSORBIDE DINITRATE - SL tablet and IV question","drugclass":"Organic nitrate vasodilator.","availability":"YES for Palestinian SL form. Palestine documents isosorbide dinitrate 5-mg sublingual tablets. A Palestinian IV ISDN product was not publicly confirmed. Palestine separately lists IV nitroglycerin 50 mg.","administration":"IV ISDN genuinely exists internationally. The researched Isoket product is 1 mg/mL concentrate, including 10-mL ampoules. It is not an ordinary undiluted IV push; it is prepared for controlled infusion, with sodium chloride or glucose as verified diluents. Use a syringe pump/controlled infusion. The SmPC notes adsorption with PVC/polyurethane tubing, so suitable compatible tubing matters. Exact local IV ISDN strength must be read from the ampoule before adding it to the ward reference.","use":"IV nitrate therapy may be used for severe/unstable angina and refractory left-ventricular failure when clinically indicated; the locally documented 5-mg SL tablet is a separate formulation.","monitor":"• Frequent/continuous BP and HR assessment because hypotension is the major immediate hazard. • Headache, flushing and dizziness are common nitrate effects. • Check PDE-5 inhibitor exposure before nitrates; the combination can cause severe hypotension. • If IV ISDN is actually used, check the administration-set material because adsorption can reduce delivered dose.","why":"Nitrates increase nitric-oxide/cGMP vasodilation; route and delivery system determine onset and how much drug actually reaches the patient.","source":"Emergency trolley meds","pages":"23–25","category":"trolley","memoryUse":"","memoryDanger":"Frequent/continuous BP and HR assessment because hypotension is the major immediate hazard.","mechanism":"Releases nitric oxide to raise cGMP and relax vascular smooth muscle, especially venous vessels.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"trolley-26","name":"DIAZEPAM","header":"DIAZEPAM","drugclass":"Benzodiazepine.","availability":"YES. Palestinian documentation includes 10-mg ampoules and 5-mg tablets; SEREPAM injection is also documented.","administration":"A standard injectable formulation is 5 mg/mL, commonly 10 mg/2 mL, for IV or IM use. For the researched current formulation, do not mix or dilute diazepam in a syringe or infusion container. If direct IV administration is used, give it slowly; when using an existing infusion line, inject close to the venous insertion site. Adult status-epilepticus labeling describes 5-10 mg IV initially, with repeats according to response and prescribing limits.","use":"Seizure/status epilepticus, severe agitation or selected procedural sedation. It is not a cardiac antiarrhythmic even if stored on a cardiac emergency trolley.","monitor":"• Have airway support, oxygen and resuscitation capability immediately available. • Monitor respiratory rate, SpO2, consciousness and BP. • Opioid + benzodiazepine exposure markedly increases sedation/respiratory-depression risk. • Use extra caution in chronic lung disease, frailty or unstable cardiovascular status. • IV diazepam can irritate veins; inspect the site during and after injection.","why":"Diazepam depresses CNS activity, so the bedside danger is loss of airway/ventilation rather than a cardiac rhythm effect.","source":"Emergency trolley meds","pages":"26–28","category":"trolley","memoryUse":"Seizure/status epilepticus, severe agitation or selected procedural sedation.","memoryDanger":"Opioid + benzodiazepine exposure markedly increases sedation/respiratory-depression risk.","mechanism":"Enhances GABA-A receptor activity, increasing inhibitory CNS signaling and suppressing seizures/sedation.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"trolley-29","name":"METOCLOPRAMIDE — PRAMIN","header":"METOCLOPRAMIDE -PRAMIN","drugclass":"Dopamine D2-antagonist/prokinetic antiemetic.","availability":"YES. The Palestinian spelling is PRAMIN. A locally registered product, METO-ALISON 10 mg/2 mL, is IV/IM; Palestinian data also list metoclopramide 10-mg ampoules and tablets.","administration":"The local METO-ALISON ampoule contains 10 mg/2 mL = 5 mg/mL for IV or IM use. For ordinary small IV antiemetic doses, administration should be slow rather than a rapid push; use the actual ampoule insert for the exact minimum time.","use":"Antiemetic/prokinetic for nausea and vomiting; now also ward-observed in IBD2, where postoperative nausea/vomiting is a common practical context.","monitor":"• Watch for acute dystonia, akathisia/restlessness and other extrapyramidal reactions, especially after parenteral dosing. • Stop/escalate for sustained neck/jaw/eye deviation, severe restlessness, rigidity or other acute abnormal movements. • Avoid routine use in known mechanical GI obstruction/perforation or where stimulating motility is unsafe. • Parkinsonian symptoms can worsen because of dopamine blockade. • Rapid IV administration can make restlessness/anxiety more prominent.","why":"D2 blockade helps nausea and gastric emptying, but the same dopamine blockade can produce acute movement disorders.","source":"Emergency trolley meds · IBD2 meds","pages":"29–31 · ward-observed 1 Oct 2026","category":"trolley","memoryUse":"Primarily antiemetic for nausea/vomiting in ED/CCU patients; cardiac relevance is secondary rather than rhythm-directed.","memoryDanger":"Stop/escalate for sustained neck/jaw/eye deviation, severe restlessness, rigidity or other acute abnormal movements.","mechanism":"Blocks dopamine D2 receptors and promotes upper-GI motility, reducing nausea and vomiting.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF.","categories":["trolley","ibd2"]},{"id":"trolley-32","name":"AMIODARONE — PROCOR","header":"AMIODARONE -PROCOR","drugclass":"Predominantly class III antiarrhythmic with multiple channel and adrenergic effects.","availability":"YES. Palestinian documentation includes amiodarone HCl 150-mg ampoules and 200-mg tablets. PROCOR 200 mg = amiodarone; it is not a separate medication.","administration":"A conventional IV ampoule contains 150 mg/3 mL = 50 mg/mL and must be diluted. For a perfusing ventricular arrhythmia, current manufacturer labeling uses 150 mg in 100 mL D5W over 10 minutes, then 1 mg/min for 6 h, then 0.5 mg/min. This must not be confused with the cardiac-arrest dose. In shock-refractory VF/pVT, the AHA adult algorithm uses 300 mg IV/IO, then 150 mg if needed. Use a pump for controlled infusions and follow the exact product's line/filter instructions.","use":"Very high relevance for selected serious ventricular arrhythmias and refractory VF/pVT; exact use depends on whether the patient has a pulse and the rhythm/algorithm.","monitor":"• Continuous ECG and BP during IV use. • Watch for hypotension and bradycardia, major acute bedside problems with IV therapy. • Monitor QT and correct important K+/Mg2+ abnormalities when feasible. • Inspect peripheral IV sites; phlebitis can occur with prolonged/concentrated peripheral infusions. • Review digoxin if amiodarone is started because amiodarone can increase digoxin exposure and both can slow AV conduction. • Do not confuse PROCOR tablet with the IV 150-mg ampoule.","why":"Amiodarone changes cardiac conduction/repolarization; the emergency dose and infusion regimen differ because arrest and perfusing arrhythmias are different situations.","source":"Emergency trolley meds","pages":"32–34","category":"trolley","memoryUse":"Very high relevance for selected serious ventricular arrhythmias and refractory VF/pVT; exact use depends on whether the patient has a pulse and the rhythm/algorithm.","memoryDanger":"Watch for hypotension and bradycardia, major acute bedside problems with IV therapy.","mechanism":"Primarily prolongs cardiac repolarization via potassium-channel blockade; also affects sodium, calcium and adrenergic signaling.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"trolley-35","name":"CALCIUM GLUCONATE","header":"CALCIUM GLUCONATE","drugclass":"IV calcium salt.","availability":"YES. Palestinian MoH data document calcium gluconate 10% x 10 mL; a Palestinian price listing also confirms the 10% 10-mL product.","administration":"A current 10% product is 100 mg/mL in a 10-mL vial. Dilution and rate depend on indication and product; use D5W or 0.9% NaCl only according to exact manufacturer/hospital directions rather than memorizing a universal \"10 mL push\" rule.","use":"Important for severe symptomatic hypocalcemia and for myocardial membrane stabilization in severe hyperkalemia when indicated. Calcium does not remove potassium from the body. AHA does not recommend routine calcium in ordinary cardiac arrest without a specific indication.","monitor":"• ECG/rhythm monitoring is appropriate during urgent administration. • Confirm the IV is secure; calcium extravasation can cause significant local tissue injury. • Check serum calcium and the indication when circumstances permit. • Do not casually mix calcium and sodium bicarbonate in the same syringe/line because precipitation is a practical incompatibility concern. • Do not assume calcium gluconate and calcium chloride contain equivalent elemental calcium.","why":"In hyperkalemia, calcium protects the myocardium electrically while other therapies shift or remove potassium.","source":"Emergency trolley meds","pages":"35–37","category":"trolley","memoryUse":"Important for severe symptomatic hypocalcemia and for myocardial membrane stabilization in severe hyperkalemia when indicated.","memoryDanger":"Confirm the IV is secure; calcium extravasation can cause significant local tissue injury.","mechanism":"Supplies calcium ions to stabilize the cardiac membrane during severe hyperkalemia; does not lower serum potassium.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"trolley-38","name":"MAGNESIUM SULFATE — MgSO4","header":"MAGNESIUM SULFATE -MgSO4","drugclass":"Electrolyte replacement; antiarrhythmic in selected ventricular arrhythmias; anticonvulsant in eclampsia.","availability":"YES. Palestinian essential-medicine data document magnesium sulfate injection 50%. A 50% product is 500 mg/mL; exact current brand status can vary.","administration":"Concentrated magnesium requires controlled administration. Routine IV replacement is diluted and infused rather than given as an uncontrolled rapid push. Use the exact product/order for concentration, dilution and infusion time.","use":"AHA says magnesium may be considered for recurrent polymorphic VT associated with long-QT syndrome/torsades de pointes. It is not a routine treatment for polymorphic VT when QT is normal and is not a generic treatment for every ventricular arrhythmia.","monitor":"• Continuous ECG/BP during urgent antiarrhythmic administration. • With repeated/high-dose therapy, monitor respiratory rate, reflexes, urine output/renal function and magnesium level when appropriate. • Toxicity can cause loss of deep-tendon reflexes, hypotension, respiratory depression and conduction abnormalities. • Renal impairment markedly increases accumulation risk. • Calcium salts can antagonize clinically significant magnesium toxicity.","why":"Magnesium stabilizes repolarization in torsades; excess magnesium depresses neuromuscular and cardiac conduction.","source":"Emergency trolley meds","pages":"38–40","category":"trolley","memoryUse":"AHA says magnesium may be considered for recurrent polymorphic VT associated with long-QT syndrome/torsades de pointes.","memoryDanger":"Toxicity can cause loss of deep-tendon reflexes, hypotension, respiratory depression and conduction abnormalities.","mechanism":"Modulates cardiac ion-channel activity and stabilizes repolarization in torsades; excess magnesium depresses neuromuscular transmission.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"trolley-41","name":"ADENOSINE","header":"ADENOSINE","drugclass":"Ultra-short-acting AV-nodal blocking antiarrhythmic.","availability":"YES. Palestinian documentation includes adenosine 6-mg ampoules. A standard international form is 3 mg/mL, 6 mg/2 mL.","administration":"Technique is critical: rapid IV bolus -> immediate rapid saline flush -> continuous ECG observation. Use a port as close to the patient as practical. For stable regular narrow-complex tachycardia, current AHA ACLS treatment is 6 mg rapid IV, followed if necessary by 12 mg. Vagal maneuvers come first when appropriate.","use":"For stable regular narrow-complex SVT. It may also be considered in a stable regular monomorphic wide-complex tachycardia, but do not use it in unstable, irregularly irregular or polymorphic wide-complex tachycardia.","monitor":"• Use continuous ECG before administration whenever the emergency allows. • Warn the conscious patient that flushing, chest pressure, breathlessness and a frightening brief \"pause\" sensation can occur. • Be prepared for transient AV block/asystole. • Asthma matters: severe bronchospasm can occur; AHA identifies asthma as a contraindication. • A transplanted heart or central venous injection can produce greater sensitivity; substantially smaller doses may be needed. • Do not slowly inject through long tubing.","why":"Adenosine is cleared in seconds; rapid push and immediate flush are needed so enough drug reaches the AV node before it is metabolized.","source":"Emergency trolley meds","pages":"41–43","category":"trolley","memoryUse":"For stable regular narrow-complex SVT.","memoryDanger":"Asthma matters: severe bronchospasm can occur; AHA identifies asthma as a contraindication.","mechanism":"Transiently activates adenosine A1 receptors in the AV node, slowing or blocking AV conduction.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"trolley-44","name":"DIGOXIN","header":"DIGOXIN","drugclass":"Cardiac glycoside; positive inotrope and AV-nodal slowing agent.","availability":"YES. Palestinian documentation includes 0.5-mg ampoules, 0.25-mg tablets and 0.05 mg/mL oral liquid.","administration":"A current injectable product contains 0.25 mg/mL; 0.5 mg/2 mL for IV or IM use, with IV preferred when parenteral therapy is required. The researched label states dilution is not required. Give IV digoxin slowly rather than as a rapid push; the total loading strategy matters more than treating one ampoule as one standard dose.","use":"AHA lists digoxin as an option for ventricular rate control in selected AF/flutter patients, but it is used less commonly for rapid acute rate control because onset is slower. Do not give digoxin for pre-excited AF/flutter.","monitor":"• Check HR and rhythm before administration. • Review renal function; reduced clearance increases toxicity risk. • Check K+ and Mg2+ when relevant because electrolyte disturbance can increase arrhythmic toxicity. • Watch for nausea/vomiting, confusion, visual disturbance, bradycardia, AV block or new ventricular ectopy as toxicity signals. • Review interaction with amiodarone and verapamil; both can increase exposure and/or compound AV-node slowing. • Interpret a digoxin level with sample timing, renal function and clinical findings.","why":"Digoxin has a narrow therapeutic window; kidney function, electrolytes and interacting AV-node drugs strongly change toxicity risk.","source":"Emergency trolley meds","pages":"44–46","category":"trolley","memoryUse":"","memoryDanger":"Watch for nausea/vomiting, confusion, visual disturbance, bradycardia, AV block or new ventricular ectopy as toxicity signals.","mechanism":"Inhibits the cardiac Na+/K+-ATPase, increasing intracellular calcium and contractility; also increases vagal slowing of AV conduction.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"trolley-47","name":"AMINOPHYLLINE","header":"AMINOPHYLLINE","drugclass":"Methylxanthine bronchodilator; theophylline-ethylenediamine complex.","availability":"YES. Palestinian documentation includes aminophylline 240-250-mg ampoules. A current IV product is 25 mg/mL.","administration":"Treat it as a controlled IV infusion drug, not a casual rapid IV push. Loading and maintenance depend on patient characteristics, recent theophylline/aminophylline exposure and, when available, serum theophylline concentration. Before an emergency loading dose, establish whether the patient has recently received theophylline/aminophylline.","use":"A bronchodilator that may still appear on emergency trolleys/local protocols. Its narrow therapeutic index and pro-arrhythmic potential are particularly relevant in a CCU patient.","monitor":"• Monitor HR/rhythm; tachycardia and atrial/ventricular arrhythmias are important toxicity manifestations. • Watch for early toxicity: nausea, vomiting, tremor, agitation and persistent tachycardia. • Severe toxicity can progress to seizures and life-threatening arrhythmias. • Check theophylline concentration when clinically available, especially with repeated treatment or suspected toxicity. • Clearance changes with age, illness, smoking status and interacting medicines. • 240-250 mg is ampoule content, not automatically the patient dose.","why":"Aminophylline has a narrow therapeutic range, so an extra loading dose or fast administration can quickly become pro-arrhythmic and neurotoxic.","source":"Emergency trolley meds","pages":"47–49","category":"trolley","memoryUse":"A bronchodilator that may still appear on emergency trolleys/local protocols.","memoryDanger":"Severe toxicity can progress to seizures and life-threatening arrhythmias.","mechanism":"An aminophylline/theophylline preparation: inhibits phosphodiesterases and antagonizes adenosine receptors, relaxing bronchial smooth muscle.","mechanismBasis":"Concise conceptual pharmacology addition; not quoted from the CCU PDF."},{"id":"ibd2-acamol","name":"ACAMOL — paracetamol (acetaminophen)","header":"ACAMOL — paracetamol / acetaminophen","drugclass":"Non-opioid analgesic and antipyretic.","availability":"WARD-OBSERVED in IBD2 at Nasser Medical Complex on 1 Oct 2026. Acamol tablets contain paracetamol; a common marketed tablet is 500 mg, but verify the exact ward pack and strength before administration.","use":"Mild-to-moderate pain and fever; in orthopaedics it is commonly part of multimodal pain control after injury or surgery.","administration":"Give only by the ordered route/formulation. Before administering, calculate the patient's total paracetamol/acetaminophen exposure from ALL products in the previous 24 hours. Do not assume a fixed universal maximum for every patient; liver disease, alcohol use, frailty and other factors can lower the safe limit.","monitor":"• Assess pain/temperature before and after administration. • Check for duplicate paracetamol/acetaminophen in combination products. • Review liver disease, heavy alcohol use and total 24-hour exposure. • Escalate suspected overdose promptly because serious hepatotoxicity can be delayed.","why":"Paracetamol provides analgesia and antipyresis without the platelet/GI effects typical of NSAIDs, but excessive total exposure can cause severe liver injury.","source":"IBD2 meds · ward observation + current product information","pages":"Nasser orthopaedic rotation · 1 Oct 2026","category":"ibd2","categories":["ibd2"],"memoryUse":"Pain/fever; common non-opioid component of postoperative and fracture pain control.","memoryDanger":"Count total paracetamol from every product; overdose can cause severe liver injury.","mechanism":"Predominantly central analgesic/antipyretic action involving inhibition of prostaglandin synthesis in the CNS.","mechanismBasis":"Brand identity checked against current Acamol product information; nursing safety aligned with current acetaminophen labeling."},{"id":"ibd2-trufen","name":"TRUFEN — ibuprofen","header":"TRUFEN — ibuprofen","drugclass":"NSAID; analgesic, antipyretic and anti-inflammatory.","availability":"WARD-OBSERVED in IBD2 at Nasser Medical Complex on 1 Oct 2026. Palestinian MoH records Trufen 200 mg and 600 mg tablets as ibuprofen. IMPORTANT: Trufen Extra is a different combination product containing ibuprofen + paracetamol, so read the package before giving.","use":"Mild-to-moderate musculoskeletal pain and inflammation, including painful swelling after soft-tissue injury and orthopaedic conditions.","administration":"PO when the ordered product is a tablet. Verify the exact strength and whether it is plain Trufen or Trufen Extra. Use the lowest effective ordered dose for the shortest appropriate duration; do not duplicate with another NSAID unless specifically intended.","monitor":"• Assess pain and inflammation before/after. • Watch for GI pain, melena/hematemesis or other bleeding. • Review renal function, hydration and concurrent nephrotoxic drugs. • Check for NSAID/aspirin hypersensitivity or bronchospasm history. • NSAIDs can worsen fluid retention/BP and increase cardiovascular risk. • Verify combination products to avoid accidental extra paracetamol.","why":"COX inhibition reduces prostaglandins, improving pain and inflammation but also reducing gastric protection and renal prostaglandin effects.","source":"IBD2 meds · ward observation + Palestinian MoH/current NSAID safety","pages":"Nasser orthopaedic rotation · 1 Oct 2026","category":"ibd2","categories":["ibd2"],"memoryUse":"Musculoskeletal pain + inflammation.","memoryDanger":"GI bleeding and kidney injury; verify plain Trufen vs Trufen Extra before giving.","mechanism":"Reversibly inhibits cyclooxygenase (COX) enzymes, reducing prostaglandin synthesis.","mechanismBasis":"Brand strengths checked against current Palestinian MoH product records; class safety aligned with current ibuprofen/NSAID labeling."},{"id":"ibd2-cefazolin","name":"CEFAZOLIN","header":"CEFAZOLIN","drugclass":"First-generation cephalosporin antibacterial.","availability":"WARD-OBSERVED in IBD2 at Nasser Medical Complex on 1 Oct 2026. Exact vial strength/formulation in the ward was not recorded; verify the vial, diluent, route and local order.","use":"Highly relevant to orthopaedics for perioperative antibacterial prophylaxis and for treatment of susceptible bacterial infections when prescribed.","administration":"Parenteral product; preparation and IV administration depend on the exact vial/product and order. Do not memorize one dilution or rate across all cefazolin products. Adjusted dosing may be needed with renal impairment.","monitor":"• Verify beta-lactam allergy history and watch for hypersensitivity/anaphylaxis. • Review renal function and ordered dose/interval. • Monitor IV site and clinical response. • Watch for significant antibiotic-associated diarrhea/C. difficile features. • For prophylaxis, timing relative to surgery matters—follow the surgical protocol/order.","why":"Cefazolin inhibits bacterial cell-wall synthesis. In surgery, adequate tissue levels at the time of incision help reduce surgical-site infection risk.","source":"IBD2 meds · ward observation + current DailyMed cefazolin labeling","pages":"Nasser orthopaedic rotation · 1 Oct 2026","category":"ibd2","categories":["ibd2"],"memoryUse":"Orthopaedic perioperative prophylaxis and susceptible bacterial infection.","memoryDanger":"Check allergy + renal function; preparation/timing are product- and protocol-specific.","mechanism":"Beta-lactam cephalosporin that binds penicillin-binding proteins and inhibits bacterial cell-wall synthesis.","mechanismBasis":"Drug-specific safety and perioperative indication checked against current 2026 DailyMed cefazolin prescribing information."},{"id":"ibd2-tramadol","name":"TRAMADOL — oral capsule / ward formulation","header":"TRAMADOL","drugclass":"Opioid analgesic with additional serotonin/norepinephrine reuptake effects.","availability":"WARD-OBSERVED in IBD2 at Nasser Medical Complex on 1 Oct 2026, including an oral capsule. Other ward formulations may differ; verify the exact product, strength and route before administration.","use":"Moderate-to-severe pain when an opioid analgesic is prescribed; common relevance after fractures, major trauma or surgery.","administration":"For the oral capsule, give PO exactly as ordered and confirm formulation/strength. Do not assume oral and parenteral products are interchangeable. Avoid unverified route conversion. Dose selection can require adjustment for renal/hepatic impairment and interacting medicines.","monitor":"• Assess pain, respiratory rate/effort, sedation/level of consciousness and fall risk. • Serious respiratory depression can occur, especially with other CNS depressants. • Tramadol can cause seizures and serotonin syndrome. • Watch for nausea, dizziness and constipation. • Combining with gabapentin or sedating promethazine can increase sedation/respiratory risk. • Escalate excessive sedation, slow/shallow breathing or reduced responsiveness.","why":"Opioid activity provides analgesia, while monoamine effects contribute to both analgesia and interaction risks such as serotonin syndrome and seizures.","source":"IBD2 meds · ward observation + current DailyMed tramadol labeling","pages":"Nasser orthopaedic rotation · 1 Oct 2026","category":"ibd2","categories":["ibd2"],"memoryUse":"Stronger analgesia for moderate-to-severe acute pain.","memoryDanger":"Sedation/respiratory depression; also seizures and serotonin syndrome.","mechanism":"Weak mu-opioid receptor agonism plus inhibition of serotonin and norepinephrine reuptake.","mechanismBasis":"Safety points checked against current 2026 DailyMed tramadol labeling."},{"id":"ibd2-meropenem","name":"MEROPENEM","header":"MEROPENEM","drugclass":"Carbapenem (penem) broad-spectrum beta-lactam antibacterial.","availability":"WARD-OBSERVED in IBD2 at Nasser Medical Complex on 1 Oct 2026. Exact vial strength was not recorded; verify the vial and order.","use":"Serious susceptible bacterial infections. Current labeling includes complicated skin/skin-structure infection; it should not be treated as routine orthopaedic prophylaxis simply because it is broad spectrum.","administration":"IV. Reconstitution, dilution, infusion method and dose depend on the exact product, indication and renal function. Current labeling requires dose adjustment when renal function is reduced.","monitor":"• Check beta-lactam allergy history and monitor for hypersensitivity. • Review renal function because accumulation increases adverse-effect risk. • Watch for seizures/neurologic changes, particularly with renal impairment or CNS disease. • Monitor for significant diarrhea/C. difficile. • IMPORTANT interaction: meropenem can markedly lower valproic acid/divalproex concentrations and trigger breakthrough seizures.","why":"Meropenem inhibits bacterial cell-wall synthesis and has broad activity, but broad coverage does not replace culture-guided therapy and antimicrobial stewardship.","source":"IBD2 meds · ward observation + current DailyMed meropenem labeling","pages":"Nasser orthopaedic rotation · 1 Oct 2026","category":"ibd2","categories":["ibd2"],"memoryUse":"Broad-spectrum IV antibiotic for serious susceptible infection.","memoryDanger":"Renal adjustment + seizure risk; major interaction with valproic acid/divalproex.","mechanism":"Carbapenem beta-lactam that binds penicillin-binding proteins and inhibits bacterial cell-wall synthesis.","mechanismBasis":"Safety, renal adjustment and valproate interaction checked against current 2026 DailyMed meropenem labeling."},{"id":"ibd2-prothiazine","name":"PROTHIAZINE — promethazine","header":"PROTHIAZINE — promethazine HCl","drugclass":"Sedating first-generation H1 antihistamine; phenothiazine antiemetic.","availability":"WARD-OBSERVED in IBD2 at Nasser Medical Complex on 1 Oct 2026. Palestinian MoH lists Prothiazine 25 mg tablets containing promethazine HCl; verify the exact pack/strength in hand.","use":"May be used for nausea/vomiting, allergic symptoms or sedation depending on the order. In postoperative patients, its sedating effect is clinically important.","administration":"For the ward tablet, PO as ordered. Do not infer an injectable route from the tablet brand. Check other sedating medicines before administration.","monitor":"• Watch drowsiness, dizziness, confusion and orthostatic hypotension/fall risk. • Promethazine has anticholinergic effects such as dry mouth and urinary retention. • Sedation/respiratory depression can be worse with opioids such as tramadol or other CNS depressants. • Escalate excessive sedation or breathing impairment.","why":"H1 blockade provides antihistamine/antiemetic effects but also causes substantial sedation and anticholinergic effects.","source":"IBD2 meds · ward observation + Palestinian MoH/current promethazine labeling","pages":"Nasser orthopaedic rotation · 1 Oct 2026","category":"ibd2","categories":["ibd2"],"memoryUse":"Sedating antihistamine/antiemetic.","memoryDanger":"Sedation + falls; additive respiratory/CNS depression with opioids.","mechanism":"Blocks histamine H1 receptors and also has anticholinergic and antidopaminergic effects.","mechanismBasis":"Brand identity checked against current Palestinian MoH records; safety aligned with current promethazine labeling."},{"id":"ibd2-gabapentin","name":"GABAPENTIN","header":"GABAPENTIN","drugclass":"Gabapentinoid anticonvulsant; neuropathic-pain agent.","availability":"WARD-OBSERVED in IBD2 at Nasser Medical Complex on 1 Oct 2026. Exact capsule/tablet strength was not recorded; verify the product and order.","use":"Neuropathic pain/nerve-related pain and seizure indications. In an orthopaedic/trauma setting it may be used when pain has a neuropathic component, but confirm the patient's actual indication.","administration":"PO. Dose selection and interval depend strongly on renal function; do not use a memorized standard dose for every patient. Chronic therapy should not be stopped abruptly without a plan.","monitor":"• Watch somnolence, dizziness, ataxia and falls. • Review renal function. • Serious respiratory depression has been reported when gabapentin is combined with CNS depressants, especially opioids. • With tramadol or other opioids, monitor sedation and breathing more closely. • Peripheral edema can occur.","why":"Gabapentin reduces excitatory neurotransmitter release through the alpha-2-delta subunit of voltage-gated calcium channels; it is useful for neuropathic rather than purely inflammatory pain.","source":"IBD2 meds · ward observation + current DailyMed gabapentin labeling","pages":"Nasser orthopaedic rotation · 1 Oct 2026","category":"ibd2","categories":["ibd2"],"memoryUse":"Neuropathic/nerve pain; also an anticonvulsant.","memoryDanger":"Drowsiness/ataxia + renal adjustment; respiratory depression risk rises with opioids.","mechanism":"Binds the alpha-2-delta subunit of voltage-gated calcium channels, reducing release of excitatory neurotransmitters.","mechanismBasis":"Respiratory-depression and renal-use safety aligned with current 2026 DailyMed gabapentin labeling."},{"id":"ibd2-avilac","name":"AVILAC — lactulose","header":"AVILAC — lactulose syrup","drugclass":"Osmotic laxative; non-absorbable disaccharide.","availability":"WARD-OBSERVED in IBD2 at Nasser Medical Complex on 1 Oct 2026. Avilac syrup contains lactulose 66.7 g/100 mL in current product information; verify the bottle in hand.","use":"Constipation. In orthopaedic patients, constipation may be promoted by immobility and opioid analgesics. Lactulose is also used in hepatic encephalopathy for a different indication.","administration":"PO syrup as ordered. Measure the ordered volume accurately. The dose/goal differs between ordinary constipation and hepatic encephalopathy, so do not transfer one regimen to the other.","monitor":"• Monitor bowel pattern and response. • Excessive effect can cause diarrhea, abdominal cramping, dehydration and electrolyte disturbance. • Reassess if constipation persists despite therapy or if severe abdominal symptoms occur.","why":"Lactulose remains in the bowel and draws water osmotically into the colon, softening stool and promoting bowel movements.","source":"IBD2 meds · ward observation + current Avilac/lactulose product information","pages":"Nasser orthopaedic rotation · 1 Oct 2026","category":"ibd2","categories":["ibd2"],"memoryUse":"Constipation—especially relevant with immobility/opioids.","memoryDanger":"Too much effect → diarrhea, dehydration and electrolyte disturbance.","mechanism":"Non-absorbable sugar metabolized by colonic bacteria; its osmotic effect retains water in the colon and promotes stool passage.","mechanismBasis":"Avilac identity and concentration checked against current product information."},{"id":"ibd2-carbamazepine","name":"CARBAMAZEPINE","header":"CARBAMAZEPINE","drugclass":"Anticonvulsant; voltage-gated sodium-channel blocker; neuropathic-pain agent.","availability":"WARD-OBSERVED in IBD2 at Nasser Medical Complex on 1 Oct 2026. Exact tablet formulation/strength was not recorded; immediate-release, chewable, suspension and extended-release products are not automatically interchangeable.","use":"Seizure disorders and selected neuropathic-pain conditions such as trigeminal neuralgia. In an orthopaedic patient, confirm whether it is being continued for epilepsy or prescribed for a specific neuropathic-pain indication.","administration":"PO in the ordered formulation. Do not crush or interchange extended-release and immediate-release products without checking the product. Do not abruptly stop chronic therapy unless specifically directed.","monitor":"• New rash is a major red flag because SJS/TEN can occur. • Monitor CBC when ordered; rare aplastic anemia/agranulocytosis and other cytopenias are important. • Monitor sodium because SIADH/hyponatremia can cause confusion, weakness, seizures and falls. • Watch dizziness, drowsiness and ataxia. • Carbamazepine has many drug interactions because it induces hepatic enzymes.","why":"Sodium-channel blockade reduces repetitive neuronal firing, helping seizures and selected neuropathic pain, but the drug has important hematologic, dermatologic, electrolyte and interaction risks.","source":"IBD2 meds · ward observation + current DailyMed carbamazepine labeling","pages":"Nasser orthopaedic rotation · 1 Oct 2026","category":"ibd2","categories":["ibd2"],"memoryUse":"Seizures + selected neuropathic pain.","memoryDanger":"New rash, falling blood counts or symptomatic hyponatremia require prompt review.","mechanism":"Stabilizes inactivated voltage-gated sodium channels, reducing sustained repetitive neuronal firing.","mechanismBasis":"SJS/TEN, blood-dyscrasia and hyponatremia warnings checked against current 2026 DailyMed carbamazepine labeling."}];const aids=[{"id":"ccu-iv-guide","name":"IV administration decision aid","source":"Used in CCU meds","pages":"93–97","body":"IV ADMINISTRAT ION DECISION AID Step 1 - Identify the IV medication type Continuous vasoactive / titrated drugs: norepinephrine, dopamine, dobutamine and therapeutic heparin infusion require controlled continuous delivery. Use an infusion pump. Do not improvise an IV push. Intermittent infusions: levofloxacin, linezolid and metronidazole should be delivered over the required infusion time with a pump or accurate regulator as appropriate. Slow IV injection allowed: verapamil, ceftazidime, furosemide, atropine and some pantoprazole products have slow-injection options according to the actual product/protocol. Step 2 - Choose the line/device Norepinephrine: central access preferred for ongoing/concentrated therapy; a suitable proximal peripheral line may be acceptable short-term with frequent site checks. Dobutamine: peripheral administration may be acceptable with monitoring; central access is preferable for concentrated/prolonged therapy. Dopamine: a large peripheral vein may be used initially with frequent inspection; central access is preferred for prolonged/concentrated infusion. Therapeutic heparin: controlled infusion through a pump; peripheral or central access may be used depending on the unit setup. Step 3 - Final bedside check Read the vial first: drug + concentration + order + push vs slow injection vs intermittent infusion vs continuous titrated infusion + required monitoring -> then choose the line/device. Do not memorize one fixed bag volume when donated brands, strengths or local stock can vary."},{"id":"trolley-emergency-flow","name":"Emergency rhythm and metabolic mini-flow","source":"Emergency trolley meds","pages":"50–58","body":"Emergency rhythm and metabolic mini-flow This is a memory structure, not a replacement for the current ACLS algorithm or physician order. It reflects the researched 2025 AHA adult advanced-life-support framework. TACHYCARDIA WITH A PULSE Unstable? Hypotension / shock / ischemic chest discomfort / acute heart failure / altered mental status -> Synchronized cardioversion rather than delaying for adenosine or an antiarrhythmic infusion. Stable + regular narrow-complex SVT Vagal maneuver -> Adenosine 6 mg RAPID IV + immediate flush -> Still SVT? -> Adenosine 12 mg RAPID IV + immediate flush Stable regular monomorphic wide-complex tachycardia Adenosine may be considered if truly regular and monomorphic or appropriate antiarrhythmic infusion / expert management. Irregularly irregular / polymorphic / unstable wide-complex tachycardia Do NOT use adenosine as a diagnostic experiment. PULSELESS VF / VT AFTER DEFIBRILLATION High-quality CPR + defibrillation + epinephrine sequence -> Shock-refractory VF/pVT -> Amiodarone OR lidocaine may be used. Typical ACLS amiodarone arrest sequence: 300 mg IV/IO -> 150 mg if needed Do not confuse this with 150 mg in 100 mL D5W over 10 min, which is a perfusing ventricular-arrhythmia infusion regimen. POLYMORPHIC VT / TORSADES WITH LONG QT Magnesium sulfate may be considered -> Correct contributing K+/Mg2+ abnormalities and address the cause. CARDIAC ARREST - no identified special indication Do not automatically give calcium or sodium bicarbonate simply because they are on the emergency trolley. Use them when a relevant special circumstance / reversible cause is identified or strongly suspected. SEVERE HYPOGLYCEMIA Check glucose when feasible without delaying lifesaving treatment -> Verify actual dextrose concentration and container -> IV glucose per protocol -> Recheck glucose + reassess consciousness -> Prevent recurrence / identify cause. SEVERE HYPERKALEMIA WITH ECG TOXICITY Cardiac membrane stabilization when indicated -> Calcium while separately addressing potassium shift/removal. Do not assume calcium itself removes K+. Sodium bicarbonate may have a role in selected circumstances when the clinical context supports it, but neither calcium nor bicarbonate should become an automatic undifferentiated-code medication. Final container-check rule READ THE CONTAINER FIRST -> Generic drug -> Total amount -> Concentration -> Volume -> Route -> Push vs slow injection vs intermittent infusion vs continuous infusion -> Required monitoring -> Then administer. Look-alike mental errors to avoid • PROCOR = amiodarone, not a separate cardiac medicine. • PRAMIN = metoclopramide. • Lidocaine for local anesthesia is not automatically suitable IV cardiac lidocaine. Check additives and intended route. • ISDN SL tablet is not the same as an IV nitrate ampoule. Palestine documents 5-mg SL ISDN and separately lists IV nitroglycerin; IV ISDN exists internationally but was not Palestine-verified in this research. • D50 means 50% concentration, not necessarily a 50-mL syringe. Research basis: Gaza CCU Emergency-Trolley Medication Addendum (Deep Research, 3 Sep 2026), using Palestinian MoH/Essential Medicines and product records, current AHA adult ALS guidance, current DailyMed/FDA manufacturer labeling, and current UK product information where needed for IV isosorbide dinitrate."}]; const CONTENT_KEY='core-nursing-content-v1';let syncedContent=null;
const bundledMeds=meds.slice(),bundledAids=aids.slice(),bundledPractice=sampleMeds.slice(),lessons=[];
function validFaq(f){return !!(f&&typeof f.id==='string'&&f.id.length<=120&&typeof f.question==='string'&&f.question.length<=500&&Array.isArray(f.sections)&&f.sections.length<=30&&f.sections.every(x=>x&&typeof x.label==='string'&&x.label.length<=200&&typeof x.text==='string'&&x.text.length<=6000)&&(!('verification' in f)||typeof f.verification==='string')&&(!('placement' in f)||['medication','clinical'].includes(f.placement))&&(!('relatedMeds' in f)||(Array.isArray(f.relatedMeds)&&f.relatedMeds.length<=50&&f.relatedMeds.every(x=>typeof x==='string'&&x.length<=120)))&&(f.placement!=='medication'||(Array.isArray(f.relatedMeds)&&f.relatedMeds.length>0)))}
function validMed(m){const req=['id','name','drugclass','availability','use','administration','monitor','why','source','pages','category','mechanism'],allowed=['ccu','trolley','verified','ibd2'];return !!(m&&req.every(k=>typeof m[k]==='string')&&m.id.length<=120&&m.name.length<=300&&allowed.includes(m.category)&&(!('categories' in m)||(Array.isArray(m.categories)&&m.categories.length>=1&&m.categories.length<=10&&m.categories.every(x=>typeof x==='string'&&allowed.includes(x))))&&(!('memoryUse' in m)||typeof m.memoryUse==='string')&&(!('memoryDanger' in m)||typeof m.memoryDanger==='string')&&(!('mechanismBasis' in m)||typeof m.mechanismBasis==='string'))}
function validGuide(g){return !!(g&&typeof g.id==='string'&&typeof g.name==='string'&&typeof g.source==='string'&&typeof g.pages==='string'&&typeof g.body==='string')}
function validLesson(l){return !!(l&&typeof l.id==='string'&&l.id.length<=120&&Number.isInteger(l.order)&&typeof l.title==='string'&&l.title.length<=300&&['lesson','quick-reference'].includes(l.kind)&&Array.isArray(l.sections)&&l.sections.length>=1&&l.sections.length<=30&&l.sections.every(s=>s&&typeof s.label==='string'&&s.label.length<=200&&typeof s.text==='string'&&s.text.length<=8000)&&(!('sourceNote' in l)||typeof l.sourceNote==='string'))}
function validPractice(q){return !!(q&&typeof q.id==='string'&&typeof q.name==='string'&&typeof q.question==='string'&&Array.isArray(q.options)&&q.options.length>=2&&q.options.length<=8&&q.options.every(x=>typeof x==='string')&&Number.isInteger(q.correct)&&q.correct>=0&&q.correct<q.options.length&&typeof q.explain==='string')}
function validContent(c){return !!(c&&typeof c==='object'&&c.schemaVersion===1&&Number.isInteger(c.contentVersion)&&c.contentVersion>0&&typeof c.updatedAt==='string'&&Array.isArray(c.faq)&&c.faq.length<=200&&c.faq.every(validFaq)&&(!('medications' in c)||(Array.isArray(c.medications)&&c.medications.length<=500&&c.medications.every(validMed)))&&(!('guides' in c)||(Array.isArray(c.guides)&&c.guides.length<=100&&c.guides.every(validGuide)))&&(!('lessons' in c)||(Array.isArray(c.lessons)&&c.lessons.length<=200&&c.lessons.every(validLesson)))&&(!('practice' in c)||(Array.isArray(c.practice)&&c.practice.length<=500&&c.practice.every(validPractice))))}
function mergeById(base,remote){const map=new Map(base.map(x=>[x.id,x]));(remote||[]).forEach(x=>map.set(x.id,x));return [...map.values()]}
function nativeHasCapability(name){try{return !!(name&&window.CoreNursingAndroid&&typeof window.CoreNursingAndroid.hasCapability==='function'&&window.CoreNursingAndroid.hasCapability(name))}catch(e){return false}}
function configureReleaseUi(){const banner=document.getElementById('legacyUpgradeBanner');if(banner)banner.hidden=nativeHasCapability('contact-email')}
function targetedRemoteMeds(){if(!syncedContent||!Array.isArray(syncedContent.targetedMedications))return [];return syncedContent.targetedMedications.filter(m=>validMed(m)&&typeof m.requiresCapability==='string'&&nativeHasCapability(m.requiresCapability))}
