llergy","answerKey":"C"},{"stem":"Which result best informs assessment of accumulation risk and possible regimen adjustment for CEFAZOLIN?","choices":[{"id":"A","text":"INR trend and prothrombin time","explanation":"These assess a coagulation pathway rather than renal clearance."},{"id":"B","text":"Creatinine trend and estimated GFR","explanation":"These inform renal clearance and regimen review."},{"id":"C","text":"ALT trend and serum bilirubin","explanation":"These assess hepatic injury rather than directly estimate renal clearance."},{"id":"D","text":"TSH trend and free thyroxine","explanation":"These assess thyroid function rather than renal elimination."}],"format":"single-best-answer","point":"Renal impairment can require review of drug exposure and the prescribed regimen.","criticalForSafety":false,"id":"ibd2-cefazolin--7-day--renal_dose","points":1,"learningPointIds":["ibd2-cefazolin::renal_dose"],"reusedFromQuestionId":"ibd2-cefazolin--standard--renal_dose","answerKey":"B"},{"stem":"During CEFAZOLIN therapy, which new bowel pattern most warrants assessment for antibiotic-associated colitis?","choices":[{"id":"A","text":"Frequent, persistent watery diarrhea","explanation":"Persistent diarrhea during antibiotic exposure needs assessment for C. difficile and other causes."},{"id":"B","text":"Normal formed stool after breakfast","explanation":"This is not a new concerning diarrhea pattern."},{"id":"C","text":"Reduced stool frequency during immobility","explanation":"This does not identify the complication being tested."},{"id":"D","text":"Hard stool with straining","explanation":"This points toward constipation rather than colitis-related diarrhea."}],"format":"single-best-answer","point":"Significant antibiotic-associated diarrhea requires evaluation.","criticalForSafety":false,"id":"ibd2-cefazolin--7-day--antibiotic_diarrhea","points":1,"learningPointIds":["ibd2-cefazolin::antibiotic_diarrhea"],"reusedFromQuestionId":"ibd2-cefazolin--standard--antibiotic_diar