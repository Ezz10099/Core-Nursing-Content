-cefazolin::cefazolin_pbp"],"reusedFromQuestionId":"ibd2-cefazolin--standard--cefazolin_pbp","answerKey":"C"},{"format":"single-best-answer","stem":"Two cefazolin products are supplied with different preparation instructions. What determines which dilution and IV method to use?","choices":[{"id":"A","text":"The dilution used for the last cefazolin patient","explanation":"A previous patient’s product and order may differ."},{"id":"B","text":"The method used for any cefazolin vial of that strength","explanation":"Strength alone does not establish identical preparation or administration instructions."},{"id":"C","text":"The supplied product instructions and the authorized order","explanation":"Preparation and IV administration are product- and order-specific."},{"id":"D","text":"The method used for another cephalosporin at the same dose","explanation":"Related antibiotics are not automatically interchangeable in preparation."}],"point":"Verify the exact cefazolin product and order before selecting preparation and IV administration instructions.","criticalForSafety":false,"id":"ibd2-cefazolin--7-day--cefazolin_product_preparation","points":1,"learningPointIds":["ibd2-cefazolin::cefazolin_product_preparation"],"reusedFromQuestionId":"ibd2-cefazolin--advanced--cefazolin_product_preparation","answerKey":"C"},{"format":"single-best-answer","stem":"Why does cefazolin prophylaxis need to be related to incision time?","choices":[{"id":"A","text":"To ensure antibiotic activity begins only once infection is confirmed","explanation":"Prophylaxis precedes established infection rather than waiting for confirmation."},{"id":"B","text":"To prevent the kidney from eliminating any antibiotic during surgery","explanation":"Elimination continues; it is not the reason for incision-related timing."},{"id":"C","text":"To produce the highest antibiotic level only after wound closure","explanation":"Waiting until closure misses the purpose of exposure at incision."},{"id":"D","text":"To provide adequate tissue antibiotic levels when contamination may occur","explanation":"The rationale is adequate tissue exposure at incision."}],"point":"Explain prophylaxis timing through adequate tissue antibiotic levels at incision.","criticalForSafety":false,"id":"ibd2-cefazolin--7-day--cefazolin_tissue_timing","points":1,"learningPointIds":["ibd2-cefazolin::cefazolin_tissue_timing"],"reusedFromQuestionId":"ibd2-cefazolin--advanced--cefazolin_tissue_timing","answerKey":"D"}],"questionCount":12}],"scoringExclusions":[]},{"itemId":"ibd2-tramadol","title":"TRAMADOL — oral capsule / ward formulation","itemType":"medication","capabilityRequirement":null,"exams":[{"id":"ibd2-tramadol--comprehensive","itemId":"ibd2-tramadol","itemType":"medication","title":"TRAMADOL — oral capsule / ward formulation","stage":"comprehensive","reviewStatus":"authoring draft","passRule":{"type":"error-count","allowedErrors":2},"timing":{"timed":false,"secondsPerQuestion":null,"timerEnforcement":"untimed"},"scoring":{"correct":1,"incorrect":0,"unanswered":0,"partialCredit":false,"unsureOrGuessed":"review flag only","criticalSafetyMiss":"separate follow-up required; original numeric score unchanged"},"feedback":"incorrect, unanswered and unsure/guessed questions only after submission","retestPolicy":"same comprehensive exam and questions at every stage","questions":[{"format":"single-best-answer","stem":"What is the direction of tramadol’s direct effect at the mu-opioid receptor?","point":"Identify weak agonism, distinct from antagonism or indirect effects.","criticalForSafety":false,"answerKey":"C","choices":[{"id":"A","text":"Competitive antagonism","explanation":"This would inhibit rather than contribute to opioid analgesia."},{"id":"B","text":"Irreversible antagonism","explanation":"Tramadol does not block the mu receptor in this way."},{"id":"C","text":"Weak agonism","explanation":"Tramadol has weak mu-opioid agonism, and its active metabolite contributes to opioid analgesia."},{"id":"D","text":"No mu activity, with opioid effects limited to kappa antagonism","explanation":"The analgesic mechanism includes mu activity."}],"id":"ibd2-tramadol--comprehensive--principal-action","points":1,"learningPointIds":["ibd2-tramadol::principal-action"],"revision":"drug-dependent-20261106","sourceFields":["mechanism"]},{"format":"single-best-answer","stem":"Which therapeutic grouping determines how oral tramadol should be treated in an analgesic safety review?","point":"Classify tramadol as an opioid with additional monoamine effects.","criticalForSafety":false,"answerKey":"A","choices":[{"id":"A","text":"Opioid analgesic with monoamine reuptake effects","explanation":"The additional mechanism does not remove the opioid classification or safety risks."},{"id":"B","text":"Non-opioid monoamine analgesic","explanation":"Tramadol has clinically important opioid activity as well as monoamine effects."},{"id":"C","text":"Non-opioid anti-inflammatory analgesic","explanation":"Tramadol does not act primarily as an NSAID."},{"id":"D","text":"Opioid antagonist analgesic","explanation":"Tramadol provides opioid analgesia through agonist activity."}],"id":"ibd2-tramadol--comprehensive--drug-class","points":1,"learningPointIds":["ibd2-tramadol::drug-class"],"revision":"drug-dependent-20261106","sourceFields":["drugclass"]},{"format":"single-best-answer","stem":"After fracture fixation, ordered non-opioid measures do not adequately control moderate-to-severe acute pain. The prescriber selects oral tramadol. Which role is intended?","point":"Recognize prescribed opioid analgesia when other pain measures are inadequate.","criticalForSafety":false,"answerKey":"C","choices":[{"id":"A","text":"Treat fracture swelling as the primary anti-inflammatory component","explanation":"Tramadol is an analgesic rather than an anti-inflammatory drug."},{"id":"B","text":"Replace operative local anaesthesia through direct nerve blockade","explanation":"Its oral opioid and reuptake effects do not provide local nerve blockade."},{"id":"C","text":"Treat the acute pain as a prescribed opioid component","explanation":"Use is guided by pain severity, adequacy of alternatives and the individual order."},{"id":"D","text":"Treat muscle spasm as the primary skeletal muscle relaxant","explanation":"Tramadol can change pain perception but is not a skeletal muscle relaxant."}],"id":"ibd2-tramadol--comprehensive--treatment-role","points":1,"learningPointIds":["ibd2-tramadol::treatment-role"],"revision":"drug-dependent-20261106","sourceFields":["use"]},{"format":"single-best-answer","stem":"After tramadol, a postoperative patient is hard to wake and has slow, shallow breaths. Which interpretation should guide escalation even if oxygen saturation is preserved on supplemental oxygen?","point":"Detect impaired ventilation and reduced responsiveness despite apparently adequate saturations.","criticalForSafety":true,"answerKey":"A","choices":[{"id":"A","text":"Possible opioid-induced ventilatory depression requiring immediate assessment","explanation":"Supplemental oxygen can preserve SpO2 even while ventilation is inadequate. Escalate and support airway and breathing per protocol."},{"id":"B","text":"Expected sedation with adequate ventilation, as shown by preserved SpO2","explanation":"SpO2 does not establish the adequacy of ventilation or consciousness."},{"id":"C","text":"Likely serotonin toxicity based on reduced respiratory drive alone","explanation":"Serotonin toxicity typically includes neuromuscular excitation and autonomic signs."},{"id":"D","text":"Likely orthostatic intolerance even while supine and hypoventilating","explanation":"This does not account for difficult arousal and depressed respiratory effort."}],"id":"ibd2-tramadol--comprehensive--opioid_respiration","points":1,"learningPointIds":["ibd2-tramadol::opioid_respiration"],"revision":"drug-dependent-20261106","sourceFields":["monitor"]},{"format":"single-best-answer","stem":"After tramadol is added to a regimen containing an SSRI, an adult has agitation, diaphoresis, tremor and inducible clonus. Which interpretation best fits?","point":"Distinguish serotonergic neuromuscular excitation from competing toxidromes.","criticalForSafety":true,"answerKey":"C","choices":[{"id":"A","text":"Isolated opioid-related sedation and respiratory depression","explanation":"This more often presents with reduced arousal and ventilatory drive rather than clonus and agitation."},{"id":"B","text":"Anticholinergic toxicity from the opioid component","explanation":"Clonus and sweating are not the typical dry anticholinergic pattern."},{"id":"C","text":"Serotonin toxicity from additive serotonergic effects","explanation":"Clonus and tremor with autonomic changes fit serotonin toxicity. Escalate promptly."},{"id":"D","text":"Uncomplicated postoperative pain with an adrenergic response","explanation":"Pain can cause sweating and agitation but does not explain the new clonus."}],"id":"ibd2-tramadol--comprehensive--serotonin","points":1,"learningPointIds":["ibd2-tramadol::serotonin"],"revision":"drug-dependent-20261106","sourceFields":["monitor"]},{"format":"single-best-answer","stem":"Which history specifically increases concern about tramadol-associated convulsions even when it is given as prescribed?","point":"Identify a seizure-risk factor and recognize that risk is not limited to overdose.","criticalForSafety":true,"answerKey":"B","choices":[{"id":"A","text":"Remote uncomplicated peptic ulcer disease","explanation":"This matters for NSAID selection but does not in itself identify tramadol-associated seizure risk."},{"id":"B","text":"Epilepsy or a history of seizures","explanation":"Tramadol can provoke seizures at recommended doses. Prior seizures increase concern and warrant review."},{"id":"C","text":"Stable chronic constipation with no seizure history","explanation":"Constipation needs separate management but does not identify this neurologic susceptibility."},{"id":"D","text":"A prior episode of opioid-related nausea without convulsions","explanation":"This informs tolerability rather than specifically increasing seizure susceptibility."}],"id":"ibd2-tramadol--comprehensive--seizure_risk","points":1,"learningPointIds":["ibd2-tramadol::seizure_risk"],"revision":"drug-dependent-20261106","sourceFields":["monitor"]},{"format":"single-best-answer","stem":"A patient due for a first assisted mobilization becomes dizzy and more drowsy after oral tramadol, with breathing unchanged. Which interpretation best fits the drug effect?","point":"Link dizziness and sedative impairment to fall risk even without respiratory depression.","criticalForSafety":true,"answerKey":"B","choices":[{"id":"A","text":"The stable respiratory rate excludes medication-related impairment of mobility","explanation":"Fall risk can rise without measurable respiratory depression."},{"id":"B","text":"Tramadol-related dizziness and sedation can impair safe transfer even with stable breathing","explanation":"Reassess alertness, balance and mobility assistance before the transfer."},{"id":"C","text":"The new symptoms indicate adequate analgesia for independent transfer","explanation":"Analgesic benefit does not establish safe coordination or alertness."},{"id":"D","text":"The symptoms establish serotonin toxicity without a neuromuscular or autonomic change","explanation":"Dizziness and drowsiness alone are more consistent with sedation than a serotonergic syndrome."}],"id":"ibd2-tramadol--comprehensive--sedation_falls","points":1,"learningPointIds":["ibd2-tramadol::sedation_falls"],"revision":"drug-dependent-20261106","sourceFields":["monitor"]},{"format":"single-best-answer","stem":"Which bowel trend is most consistent with an opioid effect after several days of tramadol in an immobilized patient?","point":"Recognize slowed transit as a common opioid effect.","criticalForSafety":false,"answerKey":"A","choices":[{"id":"A","text":"Reduced stool frequency with hard stools and straining","explanation":"Opioids can slow intestinal transit, and immobility may contribute."},{"id":"B","text":"New frequent watery stools after a course of antibiotics","explanation":"This pattern suggests diarrhea and warrants a separate assessment."},{"id":"C","text":"Black tarry stool with new postural symptoms","explanation":"This suggests possible bleeding rather than an uncomplicated opioid bowel effect."},{"id":"D","text":"Frequent loose stools with cramping after a laxative dose","explanation":"This is less characteristic of opioid-related slowing."}],"id":"ibd2-tramadol--comprehensive--constipation","points":1,"learningPointIds":["ibd2-tramadol::constipation"],"revision":"drug-dependent-20261106","sourceFields":["monitor"]},{"format":"single-best-answer","stem":"Pain on transfer was 7/10 before tramadol. Which follow-up documents analgesic benefit and separately checks a key opioid hazard?","point":"Pair comparable movement pain with sedation and respiratory surveillance.","criticalForSafety":false,"answerKey":"D","choices":[{"id":"A","text":"Rest pain is 4/10, and a normal BP is used to infer safe ventilation","explanation":"Rest and movement pain are not directly comparable, and BP does not establish ventilation."},{"id":"B","text":"Transfer pain stays at 7/10, but drowsiness is used as evidence of pain relief","explanation":"Sedation does not establish analgesic benefit."},{"id":"C","text":"No transfer is attempted, and lower stool frequency is treated as evidence of analgesia","explanation":"Bowel slowing can be an adverse effect, not an indicator of pain relief."},{"id":"D","text":"Pain on the same transfer falls to 4/10, with respiratory effort and alertness reassessed","explanation":"A comparable activity measures analgesia. Separate checks assess opioid-related harm."}],"id":"ibd2-tramadol--comprehensive--pain_response","points":1,"learningPointIds":["ibd2-tramadol::pain_response"],"revision":"drug-dependent-20261106","sourceFields":["monitor"]},{"format":"single-best-answer","stem":"Which neurotransmitter reuptake pair contributes to tramadol’s analgesic and interaction profile?","point":"Identify serotonin and norepinephrine together.","criticalForSafety":false,"answerKey":"B","choices":[{"id":"A","text":"Serotonin and dopamine","explanation":"Serotonin fits but dopamine is not the other named pathway."},{"id":"B","text":"Serotonin and norepinephrine","explanation":"Both reuptake pathways are involved."},{"id":"C","text":"Norepinephrine and dopamine","explanation":"Norepinephrine fits but dopamine is not the other relevant pathway."},{"id":"D","text":"Norepinephrine and acetylcholine","explanation":"Acetylcholine is not the other reuptake target."}],"id":"ibd2-tramadol--comprehensive--tramadol_monoamines","points":1,"learningPointIds":["ibd2-tramadol::tramadol_monoamines"],"revision":"drug-dependent-20261106","sourceFields":["mechanism"]},{"format":"single-best-answer","stem":"Which two co-medications each increase concern about respiratory depression when added to tramadol?","point":"Recognize gabapentin and sedating promethazine as additive CNS depressants.","criticalForSafety":true,"answerKey":"D","choices":[{"id":"A","text":"Gabapentin and paracetamol","explanation":"Gabapentin raises the concern. Paracetamol does not ordinarily add this CNS depressant effect."},{"id":"B","text":"Promethazine and ibuprofen","explanation":"Promethazine raises the concern. Ibuprofen does not ordinarily add CNS depressant activity."},{"id":"C","text":"Paracetamol and ibuprofen","explanation":"These non-opioids do not produce the named additive CNS depressant effect at usual doses."},{"id":"D","text":"Gabapentin and promethazine","explanation":"Both can enhance sedation when combined with an opioid and increase respiratory risk."}],"id":"ibd2-tramadol--comprehensive--tramadol_named_sedatives","points":1,"learningPointIds":["ibd2-tramadol::tramadol_named_sedatives"],"revision":"drug-dependent-20261106","sourceFields":["monitor"]},{"format":"single-best-answer","stem":"Soon after the first oral tramadol dose, a patient reports nausea and mild dizziness without clonus, abnormal ventilation, or rash. What interpretation best fits this pattern?","point":"Recognize common tramadol adverse effects and distinguish them from severe syndromes.","criticalForSafety":false,"answerKey":"B","choices":[{"id":"A","text":"Established serotonin toxicity based on gastrointestinal symptoms alone","explanation":"Serotonin toxicity requires assessment of additional characteristic features."},{"id":"B","text":"Common early adverse effects that still warrant symptom and safety reassessment","explanation":"Nausea and dizziness can occur without indicating a serious toxidrome."},{"id":"C","text":"Established opioid ventilatory depression without breathing or alertness changes","explanation":"Nausea alone does not establish compromised ventilation."},{"id":"D","text":"Established immediate hypersensitivity without skin, airway, or circulatory findings","explanation":"The findings are more compatible with known nonallergic adverse effects."}],"id":"ibd2-tramadol--comprehensive--tramadol_nausea","points":1,"learningPointIds":["ibd2-tramadol::tramadol_nausea"],"revision":"drug-dependent-20261106","sourceFields":["monitor"]},{"format":"single-best-answer","stem":"A patient has worsening renal function and chronic hepatic impairment while receiving oral tramadol. Which issue should the nurse raise before the next scheduled dose?","choices":[{"id":"A","text":"Whether declining clearance requires an earlier repeat dose to maintain a stable level","explanation":"Slower clearance can increase exposure rather than requiring more frequent dosing."},{"id":"B","text":"Whether a therapeutic pain response rules out accumulation risk","explanation":"Symptom relief does not establish that repeated exposure is safe."},{"id":"C","text":"Whether switching to parenteral tramadol removes the need for impairment review","explanation":"Changing route does not remove systemic metabolism or elimination concerns."},{"id":"D","text":"Whether accumulation warrants a lower dose, longer interval or a different analgesic plan","explanation":"Renal and hepatic impairment can affect tramadol and its active metabolite, and interactions can further change exposure."}],"point":"Recognize accumulation risk and need for formulation- and patient-specific dose or interval review.","criticalForSafety":true,"id":"ibd2-tramadol--comprehensive--tramadol_organ_review","points":1,"learningPointIds":["ibd2-tramadol::tramadol_organ_review"],"answerKey":"D"},{"format":"single-best-answer","stem":"The oral tramadol capsule ordered for a fracture patient is temporarily unavailable. Stock includes a parenteral tramadol product of the same nominal milligram strength. Which principle applies?","point":"Distinguish the oral capsule from a parenteral formulation and reject an unverified conversion.","criticalForSafety":true,"answerKey":"A","choices":[{"id":"A","text":"Use the oral order with the matching capsule or obtain a verified replacement regimen","explanation":"The same milligrams do not establish interchangeability between oral and parenteral products."},{"id":"B","text":"Inject the parenteral product on the oral schedule because the labeled milligrams match","explanation":"A change of route calls for an authorized and verified regimen."},{"id":"C","text":"Give the parenteral product orally using the capsule directions","explanation":"A parenteral formulation is not automatically appropriate for oral administration."},{"id":"D","text":"Change routes and copy the dosing interval from another patient","explanation":"Another order does not establish the route conversion or dose for this patient."}],"id":"ibd2-tramadol--comprehensive--formulation","points":1,"learningPointIds":["ibd2-tramadol::formulation"],"revision":"drug-dependent-20261106","sourceFields":["administration"]}],"questionCount":14,"correctionRevision":"tramadol-source-revi