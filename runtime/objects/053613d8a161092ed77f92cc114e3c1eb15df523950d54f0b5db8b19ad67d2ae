peutic drug concentrations with timing and clinical context.","criticalForSafety":false,"id":"ibd2-epanutin-phenytoin--7-day--drug_levels","points":1,"learningPointIds":["ibd2-epanutin-phenytoin::drug_levels"],"reusedFromQuestionId":"ibd2-epanutin-phenytoin--advanced--drug_levels","answerKey":"A"},{"stem":"A patient taking phenytoin has low albumin, ataxia, and a total level reported within range. Which interpretation is most defensible?","choices":[{"id":"A","text":"Low albumin lowers total levels and therefore excludes toxicity","explanation":"Less protein binding can increase the unbound fraction."},{"id":"B","text":"An in-range total value excludes toxicity despite the symptoms","explanation":"Total concentration alone can be misleading when binding changes."},{"id":"C","text":"Ataxia proves insufficient anticonvulsant exposure","explanation":"Ataxia is a toxicity signal, not proof of underdosing."},{"id":"D","text":"Binding changes and clinical toxicity can make the total value misleading","explanation":"Interpret levels with albumin, organ function, and symptoms."}],"format":"single-best-answer","point":"Protein binding and organ function affect interpretation of phenytoin levels.","criticalForSafety":false,"id":"ibd2-epanutin-phenytoin--7-day--phenytoin_albumin","points":1,"learningPointIds":["ibd2-epanutin-phenytoin::phenytoin_albumin"],"reusedFromQuestionId":"ibd2-epanutin-phenytoin--advanced--phenytoin_albumin","answerKey":"D"}],"questionCount":9}],"scoringExclusions":[]},{"itemId":"ibd2-vancomycin","title":"VANCOMYCIN","itemType":"medication","capabilityRequirement":null,"exams":[{"id":"ibd2-vancomycin--comprehensive","itemId":"ibd2-vancomycin","itemType":"medication","title":"VANCOMYCIN","stage":"comprehensive","reviewStatus":"authoring draft","passRule":{"type":"error-count","allowedErrors":1},"timing":{"timed":false,"secondsPerQuestion":null,"timerEnforcement":"untimed"},"scoring":{"correct":1,"incorrect":0,"unanswered":0,"partialCredit":false,"unsureO