nation":"The reference limit is not individualized and restricting the calculation to one route undercounts the total."}],"point":"Apply an individualized exposure limit rather than a universal adult maximum.","criticalForSafety":true,"answerKey":"A","id":"ibd2-acamol--comprehensive--acen_patient_limit","points":1,"learningPointIds":["ibd2-acamol::acen_patient_limit"],"revision":"drug-dependent-20261106","sourceFields":["administration"]}],"questionCount":10,"correctionRevision":"paracetamol-source-review-20261115","model":"comprehensive-v1"}],"bankVersion":6,"legacyBankVersion":4,"sources":[{"id":"content-v35"},{"id":"label-ibd2-acamol","title":"ACETAMINOPHEN TABLET [MAJOR PHARMACEUTICALS]","url":"https://dailymed.nlm.nih.gov/dailymed/drugInfo.cfm?setid=76cb8209-6c43-322e-e053-2991aa0a51eb"}],"sourceFields":{"drugclass":"Non-opioid analgesic and antipyretic.","mechanism":"Predominantly central analgesic/antipyretic action involving inhibition of prostaglandin synthesis in the CNS.","use":"Mild-to-moderate pain and fever; in orthopaedics it is commonly part of multimodal pain control after injury or surgery.","administration":"Give only by the ordered route/formulation. Before administering, calculate the patient's total paracetamol/acetaminophen exposure from ALL products in the previous 24 hours. Do not assume a fixed universal maximum for every patient; liver disease, alcohol use, frailty and other factors can lower the safe limit.","monitor":"• Assess pain/temperature before and after administration. • Check for duplicate paracetamol/acetaminophen in combination products. • Review liver disease, heavy alcohol use and total 24-hour exposure. • Escalate suspected overdose promptly because serious hepatotoxicity can be delayed.","why":"Paracetamol provides analgesia and antipyresis without the platelet/GI effects typical of NSAIDs, but excessive total exposure can cause severe liver injury.","availability":"WARD-OBSERVED in IBD2 at Nasser Medical Complex on 1 Oct 2026. Acamol tablets contain paracetamol; a common marketed tablet is 500 mg, but verify the exact ward pack and strength before administration."},"readingSections":[{"field":"drugclass","label":"Drug class","text":"Non-opioid analgesic and antipyretic.","id":"section-0-97aa2c209f83b77d"},{"field":"mechanism","label":"Mechanism of action","text":"Predominantly central analgesic/antipyretic action involving inhibition of prostaglandin synthesis in the CNS.","id":"section-1-d04ecbab35b3e972"},{"field":"use","label":"Main use","text":"Mild-to-moderate pain and fever; in orthopaedics it is commonly part of multimodal pain control after injury or surgery.","id":"section-2-f9a05cb6cb9998f3"},{"field":"administration","label":"Form & administration","text":"Give only by the ordered route/formulation. Before administering, calculate the patient's total paracetamol/acetaminophen exposure from ALL products in the previous 24 hours. Do not assume a fixed universal maximum for every patient; liver disease, alcohol use, frailty and other factors can lower the safe limit.","id":"section-3-0e21f0aac72c9411"},{"field":"monitor","label":"Nursing considerations","text":"• Assess pain/temperature before and after administration. • Check for duplicate paracetamol/acetaminophen in combination products. • Review liver disease, heavy alcohol use and total 24-hour exposure. • Escalate suspected overdose promptly because serious hepatotoxicity can be delayed.","id":"section-4-8c0b9c7e37b76a71"},{"field":"why","label":"Essential rationale","text":"Paracetamol provides analgesia and antipyresis without the platelet/GI effects typical of NSAIDs, but excessive total exposure can cause severe liver injury.","id":"section-5-83ca2568b731928c"},{"field":"availability","label":"Palestine availability","text":"WARD-OBSERVED in IBD2 at Nasser Medical Complex on 1 Oct 2026. Acamol tablets contain paracetamol; a common marketed tablet is 500 mg, but verify the exact ward pack and strength before administration.","id":"section-6-ac05d188d458a145"}],"legacyExams":[{"id":"ibd2-acamol--standard","itemId":"ibd2-acamol","itemType":"medication","title":"ACAMOL — paracetamol (acetaminophen)","stage":"standard","reviewStatus":"authoring draft","passRule":{"operator":">=","percent":90,"roundBeforeComparison":false},"timing":{"timed":false,"secondsPerQuestion":null,"timerEnforcement":"persisted total deadline: 90 seconds multiplied by question count"},"scoring":{"correct":1,"incorrect":0,"unanswered":0,"partialCredit":false,"unsureOrGuessed":"review flag only","criticalSafetyMiss":"separate follow-up required; original numeric score unchanged"},"feedback":"show keys and all option explanations after submission","retestPolicy":"same standard form after required reading","questions":[{"format":"single-best-answer","stem":"What is the principal mechanism of action of ACAMOL — paracetamol (acetaminophen)?","choices":[{"id":"A","text":"Inhibits Na/K ATPase and increases vagal tone","explanation":"This is a different pharmacological action. The drug’s action is: Paracetamol treats pain and fever without the usual NSAID platelet/GI effects."},{"id":"B","text":"Airway anti-inflammatory and bronchodilator effects","explanation":"This is a different pharmacological action. The drug’s action is: Paracetamol treats pain and fever without the usual NSAID platelet/GI effects."},{"id":"C","text":"Predominantly central analgesic/antipyretic action","explanation":"Paracetamol treats pain and fever without the usual NSAID platelet/GI effects."},{"id":"D","text":"Activates receptors to promote glucose uptake","explanation":"This is a different pharmacological action. The drug’s action is: Paracetamol treats pain and fever without the usual NSAID platelet/GI effects."}],"point":"Identify the principal pharmacological action taught for this medicine.","criticalForSafety":false,"id":"ibd2-acamol--standard--principal-action","points":1,"learningPointIds":["ibd2-acamol::principal-action"],"answerKey":"C"},{"format":"single-best-answer","stem":"Which drug class does ACAMOL — paracetamol (acetaminophen) belong to?","choices":[{"id":"A","text":"Opioid/monoamine analgesic","explanation":"The medicine is classified as: Non-opioid analgesic and antipyretic."},{"id":"B","text":"NSAID","explanation":"The medicine is classified as: Non-opioid analgesic and antipyretic."},{"id":"C","text":"Pyrazolone analgesic","explanation":"The medicine is classified as: Non-opioid analgesic and antipyretic."},{"id":"D","text":"Non-opioid analgesic","explanation":"Non-opioid analgesic and antipyretic."}],"point":"Identify the drug class taught for this medicine.","criticalForSafety":false,"id":"ibd2-acamol--standard--drug-class","points":1,"learningPointIds":["ibd2-acamol::drug-class"],"answerKey":"D"},{"format":"single-best-answer","stem":"Which is a clinical use of ACAMOL — paracetamol (acetaminophen)?","choices":[{"id":"A","text":"Relief of pain and fever","explanation":"This is a clinical use of the medicine: Mild-to-moderate pain and fever; in orthopaedics it is commonly part of multimodal pain control after injury or surgery."},{"id":"B","text":"Replacement therapy for an adrenal crisis","explanation":"This is a different treatment role."},{"id":"C","text":"Prevention of valve-related thromboembolism","explanation":"This is a different treatment role."},{"id":"D","text":"Treatment of susceptible bacterial infection","explanation":"This is a different treatment role."}],"point":"Identify the main treatment role taught for this medicine.","criticalForSafety":false,"id":"ibd2-acamol--standard--treatment-role","points":1,"learningPointIds":["ibd2-acamol::treatment-role"],"answerKey":"A"},{"stem":"A patient receives ACAMOL — paracetamol (acetaminophen) and a combination cold product. Which information is needed before assessing the next dose?","choices":[{"id":"A","text":"Total acetaminophen from all products used","explanation":"Total exposure depends on the shared active ingredient."},{"id":"B","text":"Acetaminophen from the prescription product alone","explanation":"The cold product may also contribute acetaminophen and must be checked."},{"id":"C","text":"Acetaminophen from the stronger product alone","explanation":"A lower-strength preparation still contributes to total exposure."},{"id":"D","text":"Acetaminophen since the most recent meal alone","explanation":"A meal does not reset the period used to assess cumulative exposure."}],"format":"single-best-answer","point":"Count acetaminophen from every product before assessing total exposure.","criticalForSafety":true,"id":"ibd2-acamol--standard--acetaminophen_total","points":1,"learningPointIds":["ibd2-acamol::acetaminophen_total"],"answerKey":"A"},{"stem":"After excessive total exposure to ACAMOL — paracetamol (acetaminophen), which serious toxicity is the principal concern?","choices":[{"id":"A","text":"Adrenal suppression","explanation":"This is associated with other treatments, not the primary toxicity here."},{"id":"B","text":"Hepatotoxicity","explanation":"Excess acetaminophen can cause severe liver injury."},{"id":"C","text":"Ototoxicity","explanation":"This is not the characteristic principal overdose hazard."},{"id":"D","text":"Agranulocytosis","explanation":"This is not the principal acetaminophen overdose mechanism."}],"format":"single-best-answer","point":"Suspected acetaminophen overdose needs assessment even before symptoms develop.","criticalForSafety":true,"id":"ibd2-acamol--standard--hepatic_overdose","points":1,"learningPointIds":["ibd2-acamol::hepatic_overdose"],"answerKey":"B"},{"stem":"Which paired reassessment directly measures the intended analgesic response to ACAMOL — paracetamol (acetaminophen)?","choices":[{"id":"A","text":"Stool frequency and abdominal discomfort","explanation":"These assess bowel effects rather than analgesic benefit."},{"id":"B","text":"BP and pulse during a postural change","explanation":"These assess hemodynamic tolerance rather than the pain response."},{"id":"C","text":"Pain intensity and ability to perform the agreed activity","explanation":"These compare pain and function with baseline."},{"id":"D","text":"Alertness and respiratory effort during rest","explanation":"These assess important adverse effects rather than analgesic benefit itself."}],"format":"single-best-answer","point":"Assess the intended analgesic or antipyretic response before and after treatment.","criticalForSafety":false,"id":"ibd2-acamol--standard--pain_response","points":1,"learningPointIds":["ibd2-acamol::pain_response"],"answerKey":"C"},{"format":"single-best-answer","stem":"Paracetamol is given for fever in a patient without pain. Which comparison most directly measures the intended response?","choices":[{"id":"A","text":"Pain score before and after the dose","explanation":"Pain is an analgesic outcome; it does not measure fever response in this patient."},{"id":"B","text":"Respiratory rate before and after the dose","explanation":"Respiratory rate may be clinically relevant but is not the direct measure of fever reduction."},{"id":"C","text":"Blood pressure before and after the dose","explanation":"Blood pressure does not directly measure the antipyretic response."},{"id":"D","text":"Temperature before and after the dose","explanation":"Temperature is the outcome for antipyretic treatment."}],"point":"Assess temperature response when paracetamol is given for fever.","criticalForSafety":false,"id":"ibd2-acamol--standard--acetam_fever_response","points":1,"learningPointIds":["ibd2-acamol::acetam_fever_response"],"answerKey":"D"},{"format":"single-best-answer","stem":"Which statement correctly compares paracetamol with NSAIDs?","choices":[{"id":"A","text":"Pain/fever relief without the typical NSAID platelet/GI effects","explanation":"Paracetamol lacks the typical NSAID platelet/GI effects but still has important exposure-related liver risk."},{"id":"B","text":"Equivalent GI bleeding risk but no dose-related liver risk","explanation":"This reverses the distinction and omits the major liver hazard."},{"id":"C","text":"Pain/fever relief through the same platelet inhibition as aspirin","explanation":"Paracetamol does not share the typical NSAID platelet effects."},{"id":"D","text":"Inflammation control with stronger peripheral COX inhibition","explanation":"Paracetamol acts predominantly as a central analgesic/antipyretic, rather than a stronger peripheral anti-inflammatory drug."}],"point":"Distinguish paracetamol from the typical platelet/GI effects of NSAIDs.","criticalForSafety":false,"id":"ibd2-acamol--standard--acetam_nsaid_distinction","points":1,"learningPointIds":["ibd2-acamol::acetam_nsaid_distinction"],"answerKey":"A"},{"format":"single-best-answer","stem":"Which history item is specifically relevant to the liver-risk review before paracetamol?","choices":[{"id":"A","text":"Aspirin-associated bronchospasm","explanation":"This is important when considering NSAIDs; it is not the liver-risk factor asked about."},{"id":"B","text":"Heavy alcohol use","explanation":"This is specifically relevant to the liver-risk review described for paracetamol."},{"id":"C","text":"Previous symptomatic bradycardia","explanation":"This matters for rate-slowing drugs, but is not the paracetamol liver-risk factor asked about."},{"id":"D","text":"Previous peptic-ulcer bleeding","explanation":"This is an important medication history, particularly for NSAIDs, but is not the liver-risk factor asked about."}],"point":"Include heavy alcohol use in paracetamol safety assessment.","criticalForSafety":false,"id":"ibd2-acamol--standard--acetam_alcohol_review","points":1,"learningPointIds":["ibd2-acamol::acetam_alcohol_review"],"answerKey":"B"}],"questionCount":9},{"id":"ibd2-acamol--advanced","itemId":"ibd2-acamol","itemType":"medication","title":"ACAMOL — paracetamol (acetaminophen)","stage":"advanced","reviewStatus":"authoring draft","passRule":{"operator":">","percent":90,"roundBeforeComparison":false},"timing":{"timed":true,"secondsPerQuestion":90,"timerEnforcement":"persisted total deadline: 90 seconds multiplied by question count"},"scoring":{"correct":1,"incorrect":0,"unanswered":0,"partialCredit":false,"unsureOrGuessed":"review flag only","criticalSafetyMiss":"separate follow-up required; original numeric score unchanged"},"feedback":"show keys and all option explanations after submission","retestPolicy":"different from standard","questions":[{"stem":"A prescribed acetaminophen dose is due. The patient has also used an acetaminophen-containing combination analgesic. Which exposure should be compared with the patient-specific limit?","choices":[{"id":"A","text":"Acetaminophen since the last meal in that 24 hours","explanation":"Meals do not reset cumulative drug exposure."},{"id":"B","text":"Acetaminophen from the current prescription in that 24 hours","explanation":"This omits additional exposure from the combination medicine."},{"id":"C","text":"Acetaminophen from the highest-strength product in that 24 hours","explanation":"The lower-strength preparation also contributes."},{"id":"D","text":"Total acetaminophen from all products in the relevant 24 hours","explanation":"All sources contribute to cumulative exposure."}],"format":"single-best-answer","point":"Count acetaminophen from every product before assessing total exposure.","criticalForSafety":true,"id":"ibd2-acamol--advanced--acetaminophen_total","points":1,"learningPointIds":["ibd2-acamol::acetaminophen_total"],"answerKey":"D"},{"stem":"A patient reports a potentially excessive amount of ACAMOL — paracetamol (acetaminophen) but currently has few symptoms. Which feature explains the need for prompt assessment?","choices":[{"id":"A","text":"Current temperature predicts the eventual hepatic response","explanation":"Normal temperature does not exclude overdose injury."},{"id":"B","text":"Analgesic benefit predicts the eventual hepatic response","explanation":"Pain relief cannot establish that the exposure was safe."},{"id":"C","text":"Significant hepatic injury can have delayed manifestations","explanation":"Early well-being does not exclude serious toxicity."},{"id":"D","text":"An absence of vomiting indicates rapid drug clearance","explanation":"Lack of vomiting does not establish adequate clearance."}],"format":"single-best-answer","point":"Suspected acetaminophen overdose needs assessment even before symptoms develop.","criticalForSafety":true,"id":"ibd2-acamol--advanced--hepatic_overdose","points":1,"learningPointIds":["ibd2-acamol::hepatic_overdose"],"answerKey":"C"},{"stem":"A frail patient with liver disease has a total acetaminophen exposure below a commonly quoted adult maximum. What still needs review?","choices":[{"id":"A","text":"The patient-specific safe limit rather than the generic maximum alone","explanation":"Frailty and liver disease may lower the appropriate limit."},{"id":"B","text":"The assumption that absence of pain eliminates hepatic risk","explanation":"Analgesic need does not determine hepatic safety."},{"id":"C","text":"The assumption that combination-product acetaminophen need not count","explanation":"All sources contribute to total exposure."},{"id":"D","text":"The next dose based on the generic maximum without patient factors","explanation":"A universal maximum is not safe for every patient."}],"format":"single-best-answer","point":"Review the patient-specific acetaminophen limit in frailty and liver disease.","criticalForSafety":false,"id":"ibd2-acamol--advanced--acen_patient_limit","points":1,"learningPointIds":["ibd2-acamol::acen_patient_limit"],"answerKey":"A"}],"questionCount":3},{"id":"ibd2-acamol--7-day","itemId":"ibd2-acamol","itemType":"medication","title":"ACAMOL — paracetamol (acetaminophen)","stage":"7-day","reviewStatus":"authoring draft","passRule":{"operator":">","percent":90,"roundBeforeComparison":false},"timing":{"timed":false,"secondsPerQuestion":null,"timerEnforcement":"persisted total deadline: 90 seconds multiplied by que