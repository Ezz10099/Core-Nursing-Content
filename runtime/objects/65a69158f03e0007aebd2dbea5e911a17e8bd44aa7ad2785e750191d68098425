--antimicrobial_response","points":1,"learningPointIds":["ibd2-vancomycin::antimicrobial_response"],"answerKey":"C"}],"questionCount":6},{"id":"ibd2-vancomycin--advanced","itemId":"ibd2-vancomycin","itemType":"medication","title":"VANCOMYCIN","stage":"advanced","reviewStatus":"authoring draft","passRule":{"operator":">","percent":90,"roundBeforeComparison":false},"timing":{"timed":true,"secondsPerQuestion":90,"timerEnforcement":"persisted total deadline: 90 seconds multiplied by question count"},"scoring":{"correct":1,"incorrect":0,"unanswered":0,"partialCredit":false,"unsureOrGuessed":"review flag only","criticalSafetyMiss":"separate follow-up required; original numeric score unchanged"},"feedback":"show keys and all option explanations after submission","retestPolicy":"different from standard","questions":[{"stem":"During VANCOMYCIN infusion, flushing is followed by a pressure fall. Which administration factor most plausibly contributes?","choices":[{"id":"A","text":"An insufficient antihypertensive effect","explanation":"This does not explain flushing with an infusion-related BP fall."},{"id":"B","text":"A missed scheduled antacid dose","explanation":"This does not account for the administration-linked reaction."},{"id":"C","text":"An excessive infusion rate","explanation":"Rapid administration increases the risk of an infusion reaction."},{"id":"D","text":"Insufficient oral drug absorption","explanation":"The medicine is being administered intravenously."}],"format":"single-best-answer","point":"Rapid systemic vancomycin infusion can produce an infusion reaction.","criticalForSafety":true,"id":"ibd2-vancomycin--advanced--vanco_infusion","points":1,"learningPointIds":["ibd2-vancomycin::vanco_infusion"],"answerKey":"C"},{"stem":"A concentration is near the upper laboratory reference limit during VANCOMYCIN therapy. Which information is necessary before interpreting it as clinically acceptable?","choices":[{"id":"A","text":"Dose/sample timing, organ function, and t